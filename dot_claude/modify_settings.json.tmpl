def expand(pattern):
    # ["rm", ["-rf", "-fr"]] を "rm -rf" と "rm -fr" に開く
    commands = [[]]
    for word in pattern:
        commands = [c + [w] for c in commands for w in (word if isinstance(word, list) else [word])]
    return [" ".join(c) for c in commands]


def bash(commands):
    return [f"Bash({c}*)" for c in commands]


secrets = AGENTS["secrets"]
MANAGED["model"] = AGENTS["models"]["claude"]["heavy"]
MANAGED["permissions"]["allow"] = [
    "WebSearch",
    *bash(AGENTS["commands"]["allow"]),
    "Bash(git push --force-with-lease)",
]
MANAGED["permissions"]["deny"] = [
    *[f"Read({g})" for g in secrets["workspace_globs"]],
    *[f"Read(~/{d}/{g})" for d in secrets["home_dirs"] for g in ("*", "**")],
    *bash(c for f in AGENTS["commands"]["forbidden"] for c in expand(f["pattern"])),
]


def merge(base, managed):
    for key, value in managed.items():
        if isinstance(value, dict) and isinstance(base.get(key), dict):
            merge(base[key], value)
        else:
            base[key] = copy.deepcopy(value)
    return base


current = sys.stdin.read()
config = json.loads(current) if current.strip() else {}
print(json.dumps(merge(config, MANAGED), ensure_ascii=False, indent=2))
