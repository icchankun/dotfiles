{
  "attribution": {
    "sessionUrl": false
  },
  "autoContinueAtUsageLimit": true,
  "permissions": {
    "allow": [
      "WebSearch",
      "Bash(gh issue list*)",
      "Bash(gh issue view*)",
      "Bash(gh issue status*)",
      "Bash(gh pr list*)",
      "Bash(gh pr view*)",
      "Bash(gh pr status*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr diff*)",
      "Bash(gh repo view*)",
      "Bash(gh repo list*)",
      "Bash(gh release list*)",
      "Bash(gh release view*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "Bash(gh workflow list*)",
      "Bash(gh workflow view*)",
      "Bash(gh search*)",
      "Bash(gh gist list*)",
      "Bash(gh gist view*)",
      "Bash(bundle list*)",
      "Bash(bundle info*)",
      "Bash(ruby -v*)",
      "Bash(node -v*)",
      "Bash(yarn --version*)",
      "Bash(git push --force-with-lease)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(~/.ssh/*)",
      "Read(~/.ssh/**)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -Rf *)",
      "Bash(rm -rF *)",
      "Bash(sudo *)",
      "Bash(gh pr merge*)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.bin/dev-flow-hook context",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.bin/dev-flow-hook stop",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.bin/dev-flow-hook prompt",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "~/.bin/prompt-tune-hook",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.bin/git-rewrite-guard",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "~/.bin/graphify-hook-guard search",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "~/.bin/graphify-hook-guard read",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "mise exec -- ccstatusline",
    "padding": 0
  },
  "enabledPlugins": {
    "ruby-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "deploy-on-aws@claude-plugins-official": true,
    "humanizer@humanizer": true,
    "caveman@caveman": true,
    "ponytail@ponytail": true,
    "databricks@claude-plugins-official": true,
    "claude-security@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "humanizer": {
      "source": {
        "source": "github",
        "repo": "blader/humanizer"
      }
    },
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "language": "Japanese",
  "effortLevel": "medium",
  "autoMemoryEnabled": false,
  "remoteControlAtStartup": true,
  "voiceEnabled": true,
  "agentPushNotifEnabled": true,
  "inputNeededNotifEnabled": true,
  "cleanupPeriodDays": 14,
  "model": "opus",
  "skipWorkflowUsageWarning": true
}
