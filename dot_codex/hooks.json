{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.bin/dev-flow-hook context",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.bin/dev-flow-hook stop",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.bin/dev-flow-hook prompt",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "~/.bin/prompt-tune-hook --codex",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.bin/graphify-hook-guard search",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "~/.bin/git-rewrite-guard --codex-pre"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.bin/git-rewrite-guard --codex"
          }
        ]
      }
    ]
  }
}
