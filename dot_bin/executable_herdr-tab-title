#!/bin/sh

# =============================================================================
# herdr-tab-title
# Claude Code の Stop hook: Claude Code が端末のタイトルに出した会話の要約を、
# その terminal がある Herdr.app のタブ名にする。
#
# Herdr はタブ名を端末のタイトルに合わせて変えないので、ここで写す。
# herdr-coding は reviewer を driver と同じタブに立てるため、reviewer
# （role=reviewer の label）は書き換えない。両方が書くとタブ名が行き来する。
# =============================================================================
set -u

[ -n "${HC_TERMINAL_ID:-}" ] || exit 0
command -v herdr-app >/dev/null 2>&1 || exit 0

info=$(hc get --json "$HC_TERMINAL_ID" 2>/dev/null) || exit 0
[ "$(printf '%s' "$info" | jq -r '.labels.role // empty')" = reviewer ] && exit 0
title=$(printf '%s' "$info" | jq -r '.title // empty')
tab=$(printf '%s' "$info" | jq -r '.labels."herdr.tab" // empty')
[ -n "$title" ] && [ -n "$tab" ] || exit 0

current=$(herdr-app ls 2>/dev/null | jq -r --arg tab "$tab" '.spaces[].tabs[] | select(.id == $tab) | .name // empty')
[ "$current" = "$title" ] && exit 0
herdr-app do tab.rename --id "$tab" --name "$title" >/dev/null 2>&1
exit 0
