#!/bin/sh

# =============================================================================
# herdr-worktree-open
# git-wt hook: open a worktree as a Herdr.app space right after `git wt` creates
# it, with a Claude driver in its first tab and lazygit in a second.
# (git-wt フック: `git wt` が worktree を作った直後に、Herdr.app の space として
#  開き、最初のタブで Claude を driver として、2つ目のタブで lazygit を起動する。)
#
# A worktree created by /creating-git-branches otherwise stays invisible until it
# is opened by hand. git-wt runs wt.hook in the new worktree directory, so $PWD
# is the checkout to open, and it does not run hooks when switching to an
# existing worktree, so this only fires on creation.
# (/creating-git-branches が作った worktree は、手で開くまで画面に出てこない。
#  git-wt は wt.hook を新しい worktree のディレクトリで実行するので $PWD が開く
#  対象になり、既存の worktree への切り替えではフックを実行しないので、作成時に
#  だけ走る。)
#
# Herdr.app switches to every space and tab it opens, so focus is put back on
# the terminal that ran `git wt`: that session is usually still talking to you.
# (Herdr.app は開いた space とタブに画面を切り替えるので、最後に `git wt` を
#  実行した terminal へフォーカスを戻す。そのセッションはたいてい会話中のため。)
# =============================================================================
set -eu

[ -n "${HC_TERMINAL_ID:-}" ] || exit 0
command -v herdr-app >/dev/null 2>&1 || exit 0

# A worktree that already has a space keeps it, instead of a second one appearing.
# (すでに space がある worktree は、それを使い続け、2つ目を開かない。)
herdr-app ls 2>/dev/null | jq -e --arg dir "$PWD" 'any(.spaces[]; .folder == $dir)' >/dev/null 2>&1 && exit 0

# The driver is started as plain `claude`: it runs in an interactive zsh, where
# the claude() wrapper names it `<terminal>-driver`, the name /handover sends to.
# A failure to open must not turn a successful `git wt` into an error, but it is
# reported so a missing space does not go unnoticed.
# (driver は素の `claude` で起動する。対話 zsh の中で動くので、claude() ラッパーが
#  `<terminal>-driver` と名付け、/handover の宛先になる。開けなかったことで成功した
#  `git wt` をエラーにはしないが、space が開かなかったことに気づけるよう1行で知らせる。)
argv='[]'
command -v claude >/dev/null 2>&1 && argv='["claude"]'
opened=$(herdr-app do space.new --folder "$PWD" --tab driver --argv "$argv" 2>&1) || {
  printf 'herdr-worktree-open: could not open %s in Herdr: %s\n' "$PWD" "$opened" >&2
  exit 0
}
space=$(printf '%s' "$opened" | jq -r '.space // empty')
terminal=$(printf '%s' "$opened" | jq -r '.terminal // empty')
[ "$argv" = '[]' ] || [ -z "$terminal" ] || printf 'driver: %s\n' "$(herdr-agent-name driver "$terminal")"

if command -v lazygit >/dev/null 2>&1 && [ -n "$space" ]; then
  herdr-app do tab.new --space "$space" --name lazygit --folder "$PWD" --argv '["lazygit"]' >/dev/null 2>&1 || true
fi
herdr-app do pane.focus --terminal "$HC_TERMINAL_ID" >/dev/null 2>&1 || true
