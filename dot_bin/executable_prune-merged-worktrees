#!/usr/bin/env bash

# =============================================================================
# prune-merged-worktrees
# Delete git worktrees/branches whose pull request has been merged.
# (PR がマージ済みの worktree/branch を削除する。)
#
# Dependencies / 依存:
#   - git, git-wt, gh（認証済み）, pgrep (macOS 標準)
#   - osascript (macOS 標準。失敗を通知で知らせる)
#
# Usage / 使い方:
#   prune-merged-worktrees [-n] [-q] [--root DIR] [--depth N]
#
#   -n, --dry-run   Show what would be deleted without deleting.
#                   (削除せず対象を表示するだけ。)
#   -q, --quiet     Only report repositories that had something to do.
#                   (何か処理したリポジトリだけを出力する。)
#       --root DIR  Directory to scan for repositories. (default: ~/workspace)
#       --depth N   Max search depth under --root. (default: 3)
#
# Criteria / 削除条件 (AND):
#   - A merged pull request has this branch as its head. / このブランチを head にした PR がマージ済み。
#   - The branch tip is that PR's last commit or one of its ancestors.
#     (ブランチの先端が、その PR の最後のコミットかその祖先。)
#   git の履歴ではなく PR の状態で判定するので、squash / rebase でマージしたものも拾える。
#   2 つ目は、マージ済みの PR と同じ名前で作り直したブランチの作業を消さないためのもの。
#
# Safety / 安全策:
#   - A worktree with uncommitted or untracked changes is skipped.
#     (未コミット・未追跡の変更がある worktree はスキップする。)
#   - The default branch and the main worktree are never touched.
#     (デフォルトブランチとメイン worktree には触れない。)
#   - A repository where gh fails (no network, no auth) is skipped.
#     (gh が失敗したリポジトリはスキップする。)
#
# Also removes the Claude Code sessions recorded for each deleted worktree.
# (消した worktree の Claude Code のセッションも消す。)
# =============================================================================

set -uo pipefail

# launchd starts with a minimal PATH / launchd 経由だと PATH が最小限なので補う
export PATH="/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"

# ssh-agent is not always inherited / launchd 経由で ssh-agent が引き継がれない場合の補完
if [[ -z "${SSH_AUTH_SOCK:-}" ]] && command -v launchctl >/dev/null 2>&1; then
  sock="$(launchctl getenv SSH_AUTH_SOCK 2>/dev/null)"
  [[ -n "$sock" ]] && export SSH_AUTH_SOCK="$sock"
fi

# Never block on credential prompts / 認証プロンプトで固まらないようにする
export GIT_TERMINAL_PROMPT=0
# ConnectTimeout は接続確立までにしか効かない。確立後にスリープや回線切り替えで
# 応答が止まると ssh が永久に待つので、ServerAlive* で無通信を検出して落とす。
export GIT_SSH_COMMAND="${GIT_SSH_COMMAND:-ssh -o BatchMode=yes -o ConnectTimeout=10 -o ServerAliveInterval=5 -o ServerAliveCountMax=3}"

ROOT="$HOME/workspace"
DEPTH=3
# 1 リポジトリの fetch に許す秒数。launchd は同じラベルのジョブが実行中だと次回を
# 起動しないため、1 つの fetch が固まると以降の定期実行がすべて止まる。
FETCH_TIMEOUT=120
DRY_RUN=false
QUIET=false

usage() {
  cat <<'USAGE'
Usage: prune-merged-worktrees [-n] [-q] [--root DIR] [--depth N]

Delete git worktrees/branches that are merged and gone from the remote.
(マージ済みかつリモートから消えている worktree/branch を削除する。)

  -n, --dry-run   Show what would be deleted without deleting.
                  (削除せず対象を表示するだけ。)
  -q, --quiet     Only report repositories that had something to do.
                  (何か処理したリポジトリだけを出力する。)
      --root DIR  Directory to scan for repositories. (default: ~/workspace)
      --depth N   Max search depth under --root. (default: 3)
  -h, --help      Show this help.
USAGE
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -n|--dry-run) DRY_RUN=true; shift ;;
    -q|--quiet)   QUIET=true; shift ;;
    --root)       ROOT="$2"; shift 2 ;;
    --depth)      DEPTH="$2"; shift 2 ;;
    -h|--help)    usage; exit 0 ;;
    *) echo "unknown option: $1" >&2; usage >&2; exit 1 ;;
  esac
done

log() { printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*"; }

# Send a signal to a process and all its descendants
# git を落としても ssh が孤児として残ることがあるので子孫までたどる。
kill_tree() {
  local sig="$1" pid="$2" child
  for child in $(pgrep -P "$pid" 2>/dev/null); do
    kill_tree "$sig" "$child"
  done
  kill "-$sig" "$pid" 2>/dev/null
}

# Run a command with a timeout, returning 124 on expiry
# coreutils の timeout(1) は macOS に標準で入っていないため自前で用意する。
run_with_timeout() {
  local secs="$1"; shift
  "$@" &
  local pid=$! waited=0
  while kill -0 "$pid" 2>/dev/null; do
    if (( waited >= secs )); then
      kill_tree TERM "$pid"
      sleep 2
      kill_tree KILL "$pid"
      wait "$pid" 2>/dev/null
      return 124
    fi
    sleep 1
    waited=$((waited + 1))
  done
  wait "$pid"
}

# Branches whose pull request has been merged / PR がマージ済みのブランチ
# gh が失敗したら 1 を返し、そのリポジトリを飛ばさせる。
prunable_branches() {
  local repo="$1" default="$2" branch tip head
  while IFS= read -r branch; do
    [[ "$branch" == "$default" ]] && continue
    head="$(cd "$repo" && gh pr list --head "$branch" --state merged --limit 1 \
      --json headRefOid --jq '.[0].headRefOid // empty' 2>/dev/null)" || return 1
    [[ -z "$head" ]] && continue
    tip="$(git -C "$repo" rev-parse "refs/heads/$branch")"
    # PR の先端がローカルに無ければ祖先か判定できないので、安全側に倒して残す
    [[ "$tip" == "$head" ]] || git -C "$repo" merge-base --is-ancestor "$tip" "$head" 2>/dev/null || continue
    printf '%s\n' "$branch"
  done < <(git -C "$repo" for-each-ref --format='%(refname:short)' refs/heads)
}

# Worktree path for a branch, empty if none / ブランチに対応する worktree のパス
worktree_path() {
  git -C "$1" worktree list --porcelain \
    | awk -v br="refs/heads/$2" '
        /^worktree / { path = substr($0, 10) }
        /^branch /   { if (substr($0, 8) == br) { print path; exit } }
      '
}

# The first entry of `git worktree list` is the main worktree
# (`git worktree list` の先頭がメイン worktree)
main_worktree() {
  git -C "$1" worktree list --porcelain \
    | awk '/^worktree / { print substr($0, 10); exit }'
}

# origin/HEAD, falling back to main/master / origin/HEAD がなければ main/master を見る
default_branch() {
  local repo="$1" ref branch
  ref="$(git -C "$repo" symbolic-ref --quiet refs/remotes/origin/HEAD 2>/dev/null)"
  if [[ -n "$ref" ]]; then
    printf '%s\n' "${ref#refs/remotes/origin/}"
    return
  fi
  for branch in main master; do
    if git -C "$repo" show-ref --verify --quiet "refs/heads/$branch"; then
      printf '%s\n' "$branch"
      return
    fi
  done
}

# Uncommitted or untracked changes? / 未コミット・未追跡の変更があるか
is_dirty() {
  [[ -n "$(git -C "$1" status --porcelain 2>/dev/null)" ]]
}

# Remove directories left empty by `git worktree remove`, stopping at the repo
# (worktree 削除後に空になった中間ディレクトリを、リポジトリ直下まで遡って掃除する)
prune_empty_dirs() {
  local dir="$1" stop="$2"
  while [[ "$dir" != "$stop" && "$dir" != "/" ]]; do
    rmdir "$dir" 2>/dev/null || break
    dir="$(dirname "$dir")"
  done
}

# Claude Code keeps a worktree's sessions under ~/.claude/projects/<path with
# every non-alphanumeric character replaced by "-">
# (Claude Code はセッションを、パスの英数字以外を "-" にした名前のディレクトリに置く)
remove_claude_sessions() {
  local dir="$HOME/.claude/projects/${1//[^a-zA-Z0-9]/-}"
  [[ -d "$dir" ]] && rm -rf "$dir"
}

# Delete the worktree (if any) and the branch with git wt, so its hooks run
# (git wt で worktree とブランチを消す。git wt のフックを走らせるため)
# 未コミットの変更は呼び出し側で確かめているので、-D で消す。
delete_branch() {
  local repo="$1" branch="$2" wt="$3" out
  if ! out="$(cd "$repo" && git wt -D "$branch" 2>&1)"; then
    printf '%s' "$out"
    return 1
  fi
  if [[ -n "$wt" ]]; then
    prune_empty_dirs "$(dirname "$wt")" "$repo"
    remove_claude_sessions "$wt"
  fi
}

notify_failure() {
  osascript -e 'on run argv' -e 'display notification (item 1 of argv) with title "🧹 prune-merged-worktrees"' -e 'end run' "$1" >/dev/null 2>&1 || true
}

deleted_total=0
skipped_total=0

while IFS= read -r gitdir; do
  repo="$(dirname "$gitdir")"

  run_with_timeout "$FETCH_TIMEOUT" git -C "$repo" fetch --prune --quiet 2>/dev/null
  fetch_status=$?
  if (( fetch_status == 124 )); then
    log "WARN  $repo: fetch timed out after ${FETCH_TIMEOUT}s, skipped"
    continue
  elif (( fetch_status != 0 )); then
    log "WARN  $repo: fetch failed, skipped"
    continue
  fi

  default="$(default_branch "$repo")"
  main_wt="$(main_worktree "$repo")"

  if ! branches_out="$(prunable_branches "$repo" "$default")"; then
    log "WARN  $repo: gh failed, skipped"
    continue
  fi
  [[ -z "$branches_out" ]] && continue
  mapfile -t branches <<<"$branches_out"

  "$QUIET" || log "REPO  $repo"

  for branch in "${branches[@]}"; do
    if [[ -n "$default" && "$branch" == "$default" ]]; then
      log "SKIP  $repo: $branch (default branch)"
      ((skipped_total++))
      continue
    fi

    wt="$(worktree_path "$repo" "$branch")"

    if [[ -n "$wt" && "$wt" == "$main_wt" ]]; then
      log "SKIP  $repo: $branch (checked out in the main worktree)"
      ((skipped_total++))
      continue
    fi

    if [[ -n "$wt" ]] && is_dirty "$wt"; then
      log "SKIP  $repo: $branch (uncommitted changes in $wt)"
      ((skipped_total++))
      continue
    fi

    if "$DRY_RUN"; then
      log "DRY   $repo: would delete $branch${wt:+ ($wt)}"
      ((deleted_total++))
      continue
    fi

    if out="$(delete_branch "$repo" "$branch" "$wt")"; then
      log "DEL   $repo: $branch${wt:+ ($wt)}"
      ((deleted_total++))
    else
      log "FAIL  $repo: $branch -- ${out//$'\n'/ }"
      notify_failure "$(basename "$repo"): $branch を消せませんでした"
      ((skipped_total++))
    fi
  done
done < <(find "$ROOT" -maxdepth "$DEPTH" -type d -name .git -prune 2>/dev/null | sort)

log "DONE  deleted=$deleted_total skipped=$skipped_total root=$ROOT$("$DRY_RUN" && echo ' (dry-run)')"
