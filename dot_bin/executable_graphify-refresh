#!/bin/sh

# =============================================================================
# graphify-refresh
# Claude Code and Codex Stop hook: build or refresh the graphify graph of the
# repository the session works in, so the next session can look files up in
# the graph instead of searching for them.
# (Claude Code と Codex の Stop の hook。セッションが作業しているリポジトリの
#  graphify のグラフを作るか更新する。次のセッションがファイルを探す代わりに
#  グラフを引けるようにするため。)
#
# Dependencies / 依存:
#   - git, jq, graphify (mise: pipx:graphifyy)
#
# Usage / 使い方:
#   Registered as an async Stop hook in ~/.claude/settings.json and
#   ~/.codex/hooks.json; reads the hook JSON from stdin and takes the repository
#   from its cwd. Both send the same JSON, so one script serves both.
#   (~/.claude/settings.json と ~/.codex/hooks.json に async の Stop の hook として
#    登録する。stdin の JSON の cwd からリポジトリを決める。どちらも同じ JSON を
#    渡すので、1つのスクリプトで両方に使う。)
#
# graphify update parses the code locally and uses no tokens. Unchanged files are
# served from its cache, so running it after every turn stays cheap. The graph is
# written to graphify-out/, which the global gitignore keeps out of commits. A
# checkout with no graph yet starts from the one graphify-store keeps for the
# repository.
# (graphify update は手元でコードを解析するだけで、トークンを使わない。変わって
#  いないファイルはキャッシュから読むので、ターンのたびに走らせても軽い。グラフは
#  graphify-out/ に書き、グローバルの gitignore でコミットから外す。グラフのまだ
#  ない checkout は、graphify-store がリポジトリごとに貯めたグラフから始める。)
#
# --force: without it, update keeps the old graph when the new one has fewer
# nodes, so a graph would stay stale after code is deleted.
# (--force: 付けないと、新しいグラフのノードが減ったときに古いグラフを残すので、
#  コードを消したあとグラフが古いままになる。)
#
# Log / ログ: <git dir>/graphify-refresh.log
# =============================================================================

set -eu

command -v graphify >/dev/null 2>&1 || exit 0
cwd=$(jq -r '.cwd // empty' 2>/dev/null || true)
[ -n "$cwd" ] || cwd=$PWD
top=$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null) || exit 0
# A home directory under git (bare dotfiles and the like) is not a project.
# (git で管理したホームディレクトリはプロジェクトではない。)
[ "$top" != "$HOME" ] || exit 0
gitdir=$(git -C "$top" rev-parse --absolute-git-dir)

# One build per worktree at a time. A lock left by a killed run is dropped after
# 30 minutes. (worktree ごとに同時に1つだけ動かす。強制終了で残ったロックは30分で外す。)
lock="$gitdir/graphify-refresh.lock"
find "$lock" -maxdepth 0 -mmin +30 -exec rmdir {} \; 2>/dev/null || true
mkdir "$lock" 2>/dev/null || exit 0
trap 'rmdir "$lock"' EXIT INT TERM

cd "$top"
# A checkout without a graph starts from the one graphify-store keeps, so only
# what changed since is parsed. (グラフのない checkout は、graphify-store が貯めた
# グラフから始める。そこから変わった分だけを解析する。)
"$(dirname "$0")/graphify-store" seed "$top" || true
graphify update . --force >"$gitdir/graphify-refresh.log" 2>&1 || true
