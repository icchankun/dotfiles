#!/usr/bin/env bash

# =============================================================================
# herdr-coding
# Start a reviewer beside the calling pane, which does the coding itself.
# (呼び出し元のペインが実装役を兼ね、その隣にレビュー役を立てる。)
#
# Dependencies / 依存:
#   - herdr  https://herdr.dev
#   - jq
#   - herdr-agent-name
#
# Usage / 使い方:
#   herdr-coding [options]
#
#   Options / オプション:
#     -m, --model NAME   Model for the reviewer. (レビュー役のモデル。default: sonnet)
#     -h, --help         Show this help. (このヘルプを表示する。)
#
# Notes / 補足:
#   - Panes are created without stealing focus, so the calling pane keeps it.
#     (フォーカスは奪わないので、呼び出し元のペインに留まる。)
#   - Workers start with `-n <agent name>`, so the Herdr agent name and the Claude
#     session name match. Address them with SendMessage by that name instead of
#     driving them through `herdr agent prompt`.
#     (`-n <agent名>` 付きで起動するので、Herdr の agent 名と Claude のセッション名が
#      一致する。ワーカーへは `herdr agent prompt` ではなく、その名前で SendMessage
#      を送る。)
#   - The reviewer is named after the *calling driver's* pane, not its own, so
#     re-running reuses this driver's reviewer (see herdr-agent-name).
#     (レビュー役の名前は自分ではなく呼び出した driver のペインから付くので、再実行
#      すればその driver のレビュー役が再利用される。詳細は herdr-agent-name。)
#   - The tab ends up holding only the driver and its reviewer: any other pane is
#     closed, and another driver sharing the tab is an error rather than
#     something to close, since a driver is what a person talks to.
#     (タブは driver とそのレビュー役だけになる。それ以外のペインは閉じるが、同じ
#      タブに別の driver がいるときは閉じずにエラーで止める。driver は人がやりとり
#      する相手のため。)
# =============================================================================

set -euo pipefail

# Args every worker starts with.
# (ワーカー共通の起動引数。)
readonly WORKER_ARGS=(
  # MCP off: every server's tool definitions are resent on each request, and that
  # cost multiplies by the number of workers.
  # (MCP 無効。ツール定義は毎リクエスト再送され、その費用が並列数の分だけ掛かる。)
  --strict-mcp-config
  --mcp-config '{"mcpServers":{}}'
  # Notifications off: only the driver talks to the user, so a worker going idle
  # is not something to interrupt them for.
  # (通知は無効。ユーザーとやりとりするのは driver だけなので、ワーカーが手を
  #  空けたことでユーザーを中断させない。)
  --settings '{"inputNeededNotifEnabled":false,"agentPushNotifEnabled":false}'
)

# How long to wait for a freshly split pane to become a usable shell.
# (分割直後のペインがシェルとして使えるようになるまで待つ回数と間隔。)
readonly START_ATTEMPTS=20
readonly START_INTERVAL=0.25

# The reviewer runs every round until the findings clear, so it defaults to the
# cheaper model. The bug-finding agent inside the review command pins its own
# model, so this mainly sets who sorts the findings and runs the lighter checks.
# (レビュー役は指摘がなくなるまで毎ラウンド動くので、既定は安いモデルにする。
#  レビューコマンド内でバグを探すエージェントは自分でモデルを固定しているため、
#  ここで決まるのは主に指摘の仕分けと軽い観点のチェックを担うモデル。)
model=sonnet

die() {
  printf 'herdr-coding: %s\n' "$1" >&2
  exit 1
}

usage() {
  sed -n '/^# Usage/,/^# ===/p' "$0" | sed 's/^# \{0,1\}//;$d'
}

parse_args() {
  while [ $# -gt 0 ]; do
    case "$1" in
      -m | --model) [ -n "${2:-}" ] || die "--model requires a name"; model="$2"; shift 2 ;;
      -h | --help) usage; exit 0 ;;
      *) die "unknown option: $1" ;;
    esac
  done
}

require_environment() {
  [ "${HERDR_ENV:-}" = 1 ] || die "not running inside Herdr"
  command -v herdr >/dev/null || die "herdr not found in PATH"
  command -v jq >/dev/null || die "jq not found in PATH"
  command -v herdr-agent-name >/dev/null || die "herdr-agent-name not found in PATH"
}

# Split PANE ($1) in DIRECTION ($2) and print the new pane id.
split_pane() {
  herdr pane split --pane "$1" --direction "$2" --cwd "$PWD" --no-focus |
    jq -er '.result.pane.pane_id'
}

# Print the pane the agent NAMED ($1) runs in, or nothing when it is not running.
# (NAME ($1) のエージェントが動いているペインを出力する。いなければ何も出さない。)
agent_pane() {
  herdr agent list | jq -r --arg name "$1" '
    .result.agents[] | select(.name == $name) | .pane_id' | head -n 1
}

# Start an agent NAMED ($1) in PANE ($2).
start_agent() {
  local name="$1" pane="$2" attempt

  # A pane is not an available shell the instant it is split, so starting right
  # after a split fails with agent_pane_busy. Try again until the shell is up.
  # (分割直後のペインはまだシェルとして使えず、すぐ起動すると agent_pane_busy で
  #  失敗する。シェルが立ち上がるまで試し直す。)
  for ((attempt = 1; ; attempt++)); do
    if herdr agent start "$name" --kind claude --pane "$pane" \
      -- -n "$name" --model "$model" "${WORKER_ARGS[@]}" >/dev/null 2>&1; then
      break
    fi
    [ "$attempt" -lt "$START_ATTEMPTS" ] || die "could not start $name in $pane"
    sleep "$START_INTERVAL"
  done

  # Guard against anything that renamed the pane while it was starting; the name
  # is how the worker is addressed and how the notify plugin tells it from a driver.
  # (起動中にペインを改名するものがあっても打ち消す。名前はワーカーの宛先であり、
  #  通知プラグインが driver と見分ける手掛かりでもある。)
  herdr agent rename "$pane" "$name" >/dev/null

  rows+=("$name	$pane	started")
  kept+=("$pane")
}

# Make sure this driver's worker for ROLE ($1) is running, splitting FROM ($2)
# toward DIRECTION ($3) when it is not.
# (この driver の ROLE ($1) のワーカーが動いている状態にする。いなければ FROM ($2)
#  を DIRECTION ($3) に分割して起動する。)
ensure_agent() {
  local role="$1" from="$2" direction="$3" name pane
  name=$(herdr-agent-name "$role")

  pane=$(agent_pane "$name")
  if [ -n "$pane" ]; then
    rows+=("$name	$pane	reused")
    kept+=("$pane")
  else
    pane=$(split_pane "$from" "$direction")
    start_agent "$name" "$pane"
  fi
}

# Print the tab this driver sits in.
# (この driver がいるタブを出力する。)
current_tab() {
  herdr pane list | jq -er --arg pane "$HERDR_PANE_ID" '
    .result.panes[] | select(.pane_id == $pane) | .tab_id'
}

# Print the drivers other than this one in TAB ($1).
# (TAB ($1) にいる自分以外の driver を出力する。)
other_drivers() {
  herdr agent list | jq -r --arg tab "$1" --arg self "$HERDR_PANE_ID" '
    .result.agents[]
    | select(.tab_id == $tab and .pane_id != $self and (.name | endswith("-driver")))
    | "\(.name) (\(.pane_id))"'
}

# Fail when a driver other than this one is in TAB ($1). Their workers are named
# after them, so this run cannot tell which of the tab's panes are its to clear,
# and a driver is what a person talks to rather than something to close on a guess.
# (TAB ($1) に自分以外の driver がいたら止める。そのワーカーはその driver の名前を
#  持つため、どのペインを片付けてよいか判断できない。driver は人がやりとりする
#  相手でもあり、当て推量で閉じるものではない。)
require_sole_driver() {
  local drivers
  drivers=$(other_drivers "$1")

  [ -z "$drivers" ] || die "another driver shares this tab: $(tr '\n' ' ' <<<"$drivers")"
}

# Close every pane in TAB ($1) that is not one this run named, so the tab ends up
# holding the driver and its reviewer and nothing else. A pane whose agent is
# still working is reported instead of cut off mid-task.
# (TAB ($1) のうち今回名前を付けたペイン以外を閉じ、タブを driver とレビュー役だけにする。
#  まだ作業中のエージェントが乗っているペインは、途中で切らずに報告に残す。)
prune_tab() {
  local pane status name

  while IFS=$'\t' read -r pane status name; do
    case " ${kept[*]} " in *" $pane "*) continue ;; esac

    if [ "$status" = working ]; then
      rows+=("${name:--}	$pane	kept (working)")
      continue
    fi

    herdr pane close "$pane" >/dev/null
    rows+=("${name:--}	$pane	closed")
  done < <(herdr pane list | jq -r --arg tab "$1" '
    .result.panes[]
    | select(.tab_id == $tab)
    | [.pane_id, .agent_status // "unknown", .terminal_title_stripped // ""] | @tsv')
}

start_reviewer() {
  local tab
  tab=$(current_tab)
  require_sole_driver "$tab"

  ensure_agent reviewer "$HERDR_PANE_ID" right
  prune_tab "$tab"
}

main() {
  parse_args "$@"
  require_environment

  rows=()
  kept=("$HERDR_PANE_ID")
  start_reviewer

  printf '%s\n' "AGENT	PANE	STATUS"
  printf '%s\n' "${rows[@]}"
}

main "$@"
