#!/usr/bin/env bash

# 他の人が作った PR を Codex でレビューする。reviewer が問題を見つけ、advisor が
# 1件ずつコードで確かめ、残ったものをこのスクリプトが GitHub のレビューにする。
#
# 依存:
#   - gh, git, jq, codex
#   - the reviewing-pull-requests and checking-review-findings skills
#     (icchankun/skills, deployed by apm to ~/.agents/skills)
#   - graphify (任意)
#
# 使い方:
#   codex-pr-review [--post] <PR URL | owner/repo#number>
#
#   --post を付けなければ、文面を表示するだけで GitHub には送らない。
#
# ラウンド:
#   実行のたびに、前に投稿したレビューの隠しマーカーから続きを読み戻す。
#     - 新しい push か、作者の新しい返信がある -> 次のラウンドをレビューする
#     - must か should が残っている -> COMMENT のレビューを投稿する
#     - 残っていない -> CI を待って COMMENT のレビューを投稿し、approve は人に任せる
#     - MAX_ROUNDS を超えた -> 止めて人に任せる
#   文面はレビューコメントのテンプレートに沿う。ラベル、差分の外の指摘の見出し、
#   確認したことと指摘しなかった点、解消した指摘のインラインのスレッドへの返信。
#
# 終了コード:
#   0   reviewed with Codex (Codex でレビューした)
#   3   Codex は使っていない。新しいことがないか、CI だけを見た
#   4   handed over after MAX_ROUNDS (MAX_ROUNDS を超えたので人に任せた)
#   6   指摘が残っておらず CI も通った。approve するかを自分で決める
#   75  Codex's usage limit; the message says when it resets (Codex の利用枠切れ。
#       戻る時刻はメッセージに出る)
#
# 補足:
#   - Codex は ~/.codex/config.toml の権限プロファイル dotfiles-readonly で動く。
#     読むだけで、~/.ssh と .env は読めず、GitHub の権限も持たない。投稿するのは
#     このスクリプトだけで、approve はしない。PR の中身に誘導されて、Codex が
#     指摘を出さないこともあるため。
#   - モデルは ~/.codex/config.toml の値を使わず、ここで決める。その値は Codex の
#     /model で書き換わり、役割ごとに effort も変えるため。
#   - 実行ごとの入力と Codex の結果は ~/.local/state/codex-pr-review/ に残す。

set -euo pipefail

readonly REVIEWER_MODEL=gpt-6.1-sol
readonly REVIEWER_EFFORT=medium
readonly ADVISOR_MODEL=gpt-6.1-sol
readonly ADVISOR_EFFORT=high
readonly MAX_ROUNDS=5
# reviewer に渡す履歴の量。調べる変えたファイルの数、ファイルごとのコミット数、
# コメントを読む以前の PR の数。
readonly MAX_CONTEXT_FILES=15
readonly HISTORY_COMMITS=3
readonly MAX_PAST_PRS=3
# diff.patch から外すファイル。lockfile と生成物。reviewer は中身を読まないのに、
# 差分のトークンの大半になりうる。名前は skipped-files に残す。Business プランの
# Codex は利用枠が小さいので、入力はレビューに使うものだけにする。
readonly SKIPPED_PATHSPECS=(
  ':(exclude,glob)**/*.lock' ':(exclude,glob)**/package-lock.json' ':(exclude,glob)**/npm-shrinkwrap.json'
  ':(exclude,glob)**/yarn.lock' ':(exclude,glob)**/pnpm-lock.yaml'
  ':(exclude,glob)**/*.min.js' ':(exclude,glob)**/*.min.css' ':(exclude,glob)**/*.map'
  ':(exclude,glob)**/*.snap' ':(exclude,glob)**/__snapshots__/**'
)
# conversation.json と past_reviews.json に残すコメントの本文の長さの上限。CI や
# カバレッジの bot は、レビューのコメントよりずっと長い報告を書く。
readonly MAX_BODY_CHARS=2000
# commits.md に書く PR のコミットの数の上限。新しい順。
readonly MAX_PR_COMMITS=50
# Ends every review, inline comment and reply, so a reader can tell Codex wrote
# it and not me. (レビュー・インラインのコメント・返信の最後に付ける。自分ではなく
#  Codex が書いたと分かるように。)
readonly FOOTER='🤖 Generated with [Codex](https://openai.com/codex)'

readonly STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/codex-pr-review"
readonly CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/codex-pr-review"

die() {
  printf 'codex-pr-review: %s\n' "$1" >&2
  exit 1
}

usage() {
  sed -n '/^# Usage/,/^# Notes/p' "$0" | sed 's/^# \{0,1\}//;$d'
}

post=false
target=

parse_args() {
  while [ $# -gt 0 ]; do
    case "$1" in
      --post) post=true; shift ;;
      -h | --help) usage; exit 0 ;;
      -*) die "unknown option: $1" ;;
      *) [ -z "$target" ] || die "only one pull request at a time"; target="$1"; shift ;;
    esac
  done
  [ -n "$target" ] || { usage >&2; exit 1; }

  case "$target" in
    https://github.com/*/pull/*)
      repo=$(printf '%s' "$target" | sed -E 's#https://github.com/([^/]+/[^/]+)/pull/.*#\1#')
      number=$(printf '%s' "$target" | sed -E 's#.*/pull/([0-9]+).*#\1#')
      ;;
    */*'#'*) repo="${target%%#*}" number="${target##*#}" ;;
    *) die "not a pull request: $target" ;;
  esac
  [[ "$number" =~ ^[0-9]+$ ]] || die "not a pull request number: $number"
}

require_environment() {
  local cmd
  for cmd in gh git jq codex; do
    command -v "$cmd" >/dev/null || die "$cmd not found in PATH"
  done

  skill_root=
  for dir in "$HOME/.agents/skills" "$HOME/.codex/skills"; do
    [ -f "$dir/reviewing-pull-requests/schemas/findings.json" ] && { skill_root="$dir"; break; }
  done
  [ -n "$skill_root" ] || die "reviewing-pull-requests is not installed (apm install -g)"
  [ -f "$skill_root/checking-review-findings/SKILL.md" ] || die "checking-review-findings is not installed (apm install -g)"
  schema="$skill_root/reviewing-pull-requests/schemas/findings.json"
}

# PR を読み、レビューしてはいけないものを断る。
load_pull_request() {
  pr=$(gh api "repos/$repo/pulls/$number") || die "could not read $repo#$number"
  me=$(gh api user --jq .login)

  [ "$(jq -r .state <<<"$pr")" = open ] || die "$repo#$number is not open"
  [ "$(jq -r .user.login <<<"$pr")" != "$me" ] || die "$repo#$number is your own pull request"

  author=$(jq -r .user.login <<<"$pr")
  base=$(jq -r .base.ref <<<"$pr")
  head=$(jq -r .head.sha <<<"$pr")
  key="${repo//\//__}__$number"
  pending="$STATE_DIR/pending/$key.json"
}

# このスクリプトが前に投稿したレビューから、ラウンド・見た head・残っている指摘・
# 投稿した時刻を読み戻す。
load_last_review() {
  local last data
  reviews=$(gh api --paginate --slurp "repos/$repo/pulls/$number/reviews" | jq 'add // []')
  last=$(jq -c --arg me "$me" '
    map(select(.user.login == $me and (.body | test("<!-- codex-review:v1 "))))
    | sort_by(.submitted_at) | last // empty' <<<"$reviews")

  last_round=0 last_head= last_at= open='[]'
  [ -n "$last" ] || return 0
  data=$(jq -r '.body | capture("codex-review:v1 round=(?<r>[0-9]+) head=(?<h>[0-9a-f]+) open=(?<d>[A-Za-z0-9+/=]+)") | "\(.r) \(.h) \(.d)"' <<<"$last") ||
    die "could not read the marker of the last review"
  read -r last_round last_head data <<<"$data"
  open=$(printf '%s' "$data" | base64 --decode | jq -c '.open')
  last_at=$(jq -r .submitted_at <<<"$last")
}

# The author replied after the last review, so an explanation may settle a
# finding without a push. (前回のレビューのあとに作者が返信した。push がなくても、
# 説明で解消する指摘があるかもしれない。)
author_replied() {
  [ -n "$last_at" ] || return 1
  {
    gh api --paginate --slurp "repos/$repo/issues/$number/comments"
    gh api --paginate --slurp "repos/$repo/pulls/$number/comments"
  } | jq -s -e --arg author "$author" --arg since "$last_at" '
    [.[] | add // [] | .[] | select(.user.login == $author and .created_at > $since)] | length > 0' >/dev/null
}

# head の CI の状態。pass / pending / fail。cancel は fail。チェックがないか gh が
# 失敗したときは pass とみなす。
ci_state() {
  local buckets
  buckets=$(gh pr checks "$number" -R "$repo" --json bucket --jq 'map(.bucket)' 2>/dev/null) || buckets='[]'
  jq -r 'if any(.[]; . == "fail" or . == "cancel") then "fail"
         elif any(.[]; . == "pending") then "pending" else "pass" end' <<<"${buckets:-[]}"
}

# キャッシュした bare clone から、使い捨ての worktree に head を checkout する。
# 普段作業しているリポジトリには触らない。
checkout() {
  bare="$CACHE_DIR/repos/$repo.git"
  if [ ! -d "$bare" ]; then
    mkdir -p "$(dirname "$bare")"
    gh repo clone "$repo" "$bare" -- --bare --filter=blob:none --quiet || die "could not clone $repo"
  fi
  git -C "$bare" fetch --quiet --filter=blob:none origin \
    "+refs/heads/$base:refs/heads/$base" "+refs/pull/$number/head:refs/pull/$number" ||
    die "could not fetch $repo#$number"

  tmp=$(mktemp -d)
  tree="$tmp/tree"
  trap 'git -C "$bare" worktree remove --force "$tree" >/dev/null 2>&1 || true; rm -rf "$tmp"' EXIT
  git -C "$bare" worktree add --quiet --detach "$tree" "$head"

  merge_base=$(git -C "$bare" merge-base "refs/heads/$base" "$head")

  # 2回目以降は前回から変わったところだけを読む。force push で前回の head が
  # 消えていたら、PR 全体を読み直す。
  diff_from=$merge_base
  if [ -n "$last_head" ] && git -C "$bare" cat-file -e "$last_head^{commit}" 2>/dev/null &&
    git -C "$bare" merge-base --is-ancestor "$last_head" "$head"; then
    diff_from=$last_head
  fi
}

write_input() {
  run="$STATE_DIR/runs/$key/$head-$round"
  mkdir -p "$run/input"

  jq '{number, title, body, author: .user.login, base: .base.ref, head: .head.sha, url: .html_url, draft}' <<<"$pr" >"$run/input/pr.json"
  git -C "$tree" diff --no-color --no-ext-diff --src-prefix=a/ --dst-prefix=b/ "$diff_from" "$head" -- . "${SKIPPED_PATHSPECS[@]}" >"$run/input/diff.patch"
  git -C "$tree" diff --name-only "$diff_from" "$head" | grep -vxF -f <(git -C "$tree" diff --name-only "$diff_from" "$head" -- . "${SKIPPED_PATHSPECS[@]}") >"$run/input/skipped-files" || true
  [ "$round" -eq 1 ] || printf '%s\n' "$open" >"$run/input/previous.json"

  {
    gh api --paginate --slurp "repos/$repo/issues/$number/comments"
    gh api --paginate --slurp "repos/$repo/pulls/$number/reviews"
    gh api --paginate --slurp "repos/$repo/pulls/$number/comments"
  } | jq -s --arg author "$author" --argjson max "$MAX_BODY_CHARS" '
    def who: {author: .user.login, is_pr_author: (.user.login == $author), is_bot: (.user.type == "Bot")};
    def cut: if length > $max then .[:$max] + "…（以下略）" else . end;
    (.[0] | add // [] | map(who + {kind: "comment", body: (.body | cut), created_at})) +
    (.[1] | add // [] | map(select(.body != "") | who + {kind: "review", state, body: (.body | cut), created_at: .submitted_at})) +
    (.[2] | add // [] | map(who + {kind: "inline", id, in_reply_to: .in_reply_to_id, path, line, body: (.body | cut), created_at}))
    | sort_by(.created_at)' >"$run/input/conversation.json"

  # PR のコミット。メッセージに意図が書かれていることがあり、advisor は指摘を
  # 解消したコミットをここから引く。
  git -C "$bare" log -n "$MAX_PR_COMMITS" --format='### %h %as %an%n%n%s%n%n%b' "$merge_base..$head" >"$run/input/commits.md" || true

  git -C "$bare" diff --name-only "$diff_from" "$head" | head -n "$MAX_CONTEXT_FILES" >"$run/changed-files"
  write_guidance
  write_history
  write_past_reviews
}

# 変えたファイルにかかる、ベースの CLAUDE.md と AGENTS.md を写す。ルートと、変えた
# ディレクトリとその親のもの。ベースから取るので、PR がレビューの基準を書き換え
# られない。
write_guidance() {
  local dir name path
  {
    printf '.\n'
    while read -r path; do
      dir=$(dirname "$path")
      while [ "$dir" != . ]; do printf '%s\n' "$dir"; dir=$(dirname "$dir"); done
    done <"$run/changed-files"
  } | sort -u | while read -r dir; do
    for name in CLAUDE.md AGENTS.md; do
      path=$name
      [ "$dir" = . ] || path="$dir/$name"
      git -C "$bare" cat-file -e "$merge_base:$path" 2>/dev/null || continue
      mkdir -p "$run/input/guidance/$(dirname "$path")"
      git -C "$bare" show "$merge_base:$path" >"$run/input/guidance/$path" || true
    done
  done
}

# 変えたファイルごとに、ベースでそのファイルを触った最近のコミット。コードがなぜ
# 今の形なのかを踏まえて差分を読むため。Codex はサンドボックスの中で partial
# clone から取ってこられないので、ここで書く。
write_history() {
  local path
  while read -r path; do
    printf '## %s\n\n' "$path"
    git -C "$bare" log -n "$HISTORY_COMMITS" --format='### %h %as %an%n%n%s%n%n%b' "$merge_base" -- "$path" || true
  done <"$run/changed-files" >"$run/input/history.md"
}

# 変えたファイルに、以前 merge された PR で付いたインラインのコメント。そこで
# 言われたことが今回にも当てはまることがあるため。
write_past_reviews() {
  local path shas query numbers files past
  printf '[]\n' >"$run/input/past_reviews.json"
  shas=$(while read -r path; do
    git -C "$bare" log -n "$HISTORY_COMMITS" --format=%H "$merge_base" -- "$path"
  done <"$run/changed-files" | sort -u | head -n 100)
  [ -n "$shas" ] || return 0

  query=$(printf '%s\n' "$shas" | jq -Rrs --arg owner "${repo%%/*}" --arg name "${repo#*/}" '
    split("\n") | map(select(. != "")) | to_entries
    | map("c\(.key): object(oid: \"\(.value)\") { ... on Commit { associatedPullRequests(first: 3) { nodes { number title url mergedAt } } } }")
    | "query { repository(owner: \"\($owner)\", name: \"\($name)\") { \(join(" ")) } }"')
  numbers=$(gh api graphql -f query="$query" 2>/dev/null | jq -c --argjson self "$number" --argjson max "$MAX_PAST_PRS" '
    [.data.repository[]? | .associatedPullRequests.nodes[]? | select(.mergedAt != null and .number != $self)]
    | unique_by(.number) | sort_by(.mergedAt) | reverse | .[:$max]') || return 0
  files=$(jq -R . "$run/changed-files" | jq -s .)

  jq -c '.[]' <<<"$numbers" | while read -r past; do
    gh api --paginate --slurp "repos/$repo/pulls/$(jq -r .number <<<"$past")/comments" 2>/dev/null |
      jq -c --argjson past "$past" --argjson files "$files" --argjson max "$MAX_BODY_CHARS" '
        def cut: if length > $max then .[:$max] + "…（以下略）" else . end;
        $past + {comments: [add // [] | .[] | select(.path as $p | $files | index($p)) | {author: .user.login, path, line, body: (.body | cut)}]}
        | select(.comments | length > 0)' || true
  done | jq -s . >"$run/input/past_reviews.json"
}

# Refresh the code graph for the reviewer's impact checks. It parses locally
# and uses no tokens. (reviewer が影響範囲を調べるためにグラフを更新する。手元で
# 解析するだけで、トークンは使わない。)
update_graph() {
  command -v graphify >/dev/null || return 0
  (cd "$tree" && graphify update . >"$run/graphify.log" 2>&1) || true
}

# Run one skill with codex exec and keep its JSON. Stop with the reset time
# when the usage limit is reached. (codex exec で skill を1つ動かし、JSON を残す。
# 利用枠を使い切ったら、戻る時刻を出して止める。)
run_codex() {
  local role="$1" model="$2" effort="$3" prompt="$4"
  if ! codex exec --ephemeral -m "$model" -c "model_reasoning_effort=$effort" -c 'default_permissions="dotfiles-readonly"' \
    -C "$tree" --output-schema "$schema" -o "$run/$role.json" "$prompt" </dev/null >"$run/$role.log" 2>&1; then
    grep -i 'usage limit' "$run/$role.log" >&2 && exit 75
    die "the $role failed; see $run/$role.log"
  fi
  jq -e '.findings | type == "array"' "$run/$role.json" >/dev/null || die "the $role did not return the schema; see $run/$role.json"
}

review() {
  local effort=$REVIEWER_EFFORT
  # Later rounds usually read only the change since the last review, so a lighter
  # effort is enough. (2回目以降は原則、前回からの変更だけを読むので、軽い effort で
  # 足りる。)
  [ "$round" -eq 1 ] || effort=low
  run_codex reviewer "$REVIEWER_MODEL" "$effort" \
    "\$reviewing-pull-requests を使って PR をレビューしてください。ラウンド: ${round}。入力のディレクトリ: $run/input"
  # 確かめるものがない。今回の指摘も持ち越しもなければ、advisor は reviewer の JSON を
  # そのまま返すだけなので動かさない。
  if jq -e '.findings | length == 0' "$run/reviewer.json" >/dev/null && [ "$(jq length <<<"$open")" -eq 0 ]; then
    jq '.previous = [] | .dropped = []' "$run/reviewer.json" >"$run/advisor.json"
    return
  fi
  # 2回目以降は確かめる指摘が少なく小さいので、medium で足りる。
  local advisor_effort=$ADVISOR_EFFORT
  [ "$round" -eq 1 ] || advisor_effort=medium
  run_codex advisor "$ADVISOR_MODEL" "$advisor_effort" \
    "\$checking-review-findings を使って指摘を確かめてください。ラウンド: ${round}。入力のディレクトリ: ${run}/input。reviewer が返した JSON: $run/reviewer.json"
}

# 差分の hunk の外を指す指摘は行を外す。GitHub はそこにインラインのコメントを付け
# られないので、レビューの本文の一覧にだけ出す。
place_findings() {
  local lines
  lines=$(awk '
    /^\+\+\+ b\// { file = substr($0, 7); next }
    /^\+\+\+ / { file = ""; next }
    /^@@ / { split($3, a, ","); n = substr(a[1], 2) + 0; next }
    file == "" { next }
    /^\+/ || /^ / { print file ":" n; n++; next }
  ' "$run/input/diff.patch" | jq -R . | jq -s .)
  jq --argjson lines "$lines" '
    .findings |= map(
      if .line == null then .
      elif (.file + ":" + (.line | tostring)) as $k | $lines | any(. == $k) then .
      else .line = null end)
  ' "$run/advisor.json" >"$run/findings.json"
}

# 前回の指摘を確定する。advisor が触れなかったものは残っているとみなす。次の
# ラウンドに持ち越すのは、今回の指摘と、解消していない前回の指摘。fyi は返事が
# 要らないので持ち越さない。must と should が残っていれば approve に進めず、ask・
# nit・fyi は止めない。
settle_findings() {
  jq --argjson open "$open" '
    (.previous | map({key: .id, value: .}) | from_entries) as $seen
    | .previous = [$open[] | . as $f | ($seen[$f.id] // {status: "unresolved", note: ("「" + $f.title + "」の対応を確認できませんでした")}) + {id: $f.id, severity: $f.severity, title: $f.title, file: $f.file}]
    | .open = ([.findings[] | select(.severity != "fyi")] + [$open[] | select(.id as $id | any($seen[$id]; .status == "resolved" or .status == "explained") | not)])
    | .ready = ([.open[] | select(.severity == "must" or .severity == "should")] | length == 0)
  ' "$run/findings.json" >"$run/settled.json"
  mv "$run/settled.json" "$run/findings.json"
}

# 確定した指摘から、テンプレートに沿って GitHub のレビューを組み立てる。本文には
# まだ締めの1行を入れない。指摘なし・コメント・CI 失敗の3つの締めをここで作り、
# 投稿するときにどれを使うかを選ぶ。隠しマーカーには次のラウンドに持ち越す指摘を
# 入れる。
build_review() {
  local saved
  saved=$(jq -c '{open}' "$run/findings.json" | base64 | tr -d '\n')
  jq --arg head "$head" --arg saved "$saved" --argjson round "$round" --arg footer "$FOOTER" '
    def order: {must: 0, should: 1, ask: 2, nit: 3, fyi: 4}[.severity];
    def tag: "[" + .severity + "]";
    def stop: sub("。$"; "");
    def items: map("- " + .) | join("\n");
    # 指摘1件の本文。何が起きるか、直し方の案、どれくらい任意か。
    def detail: .body
      + (if .suggestion then "\n\n直し方の案：" + .suggestion else "" end)
      + ({nit: "\n\n今のままでも動作に問題はありません。", ask: "\n\n意図どおりであれば対応は不要です。"}[.severity] // "");
    def section($title; $lines): if ($lines | length) > 0 then ["", "## " + $title, ($lines | join("\n"))] else [] end;
    (.findings | sort_by(order)) as $f
    | [$f[] | select(.severity != "fyi")] as $main
    | [$f[] | select(.severity == "fyi")] as $fyi
    | [$main[] | select(.line == null)] as $outside
    | (.open // []) as $open
    | ([$open[] | select(.severity == "must" or .severity == "should") | .severity] | unique | sort_by({must: 0, should: 1}[.]) | map("[" + . + "]") | join(" / ")) as $blocking
    | (if any($f[], $open[]; .severity == "nit") then "[nit] は任意です。" else "" end) as $nit
    # 差分の外の指摘はインラインにできないので、本文に書き出す。
    | ($outside | map(["", "### " + tag + " " + .title, "", "差分の外のため本文に書きます。", "", detail])) as $outside_sections
    | (if $round == 1 then
        ["レビューしました。" + (.summary // "")]
        + section("主な指摘"; $main | map("- " + tag + " " + .title + "（" + .file + "）"))
        + ($outside_sections | add // [])
        + section("インラインにしなかった点 / 範囲外";
            ($fyi | map("- " + tag + " " + .title + (if .line == null then "：" + (.body | gsub("\n"; " ")) else "（インラインに書いています）" end)))
            + (if .scope_note then ["- " + .scope_note] else [] end))
        + section("確認したこと"; (.checked // []) | map("- " + .))
        + section("指摘しなかった点"; (.not_flagged // []) | map("- " + .))
      else
        ["前回の指摘への対応を確認しました。（" + $head[:7] + " まで）"]
        + section("前回の指摘"; .previous | sort_by(order) | map("- " + tag + " " + .title + " → "
            + if .status == "resolved" then "✅ 対応を確認しました" + (if .commit then "（" + .commit + "）" else "" end)
              elif .status == "explained" then "✅ 回答で了解しました"
              elif .severity == "ask" then "⏳ 回答待ち"
              else "⏳ 未対応です（" + (.note | stop) + "）" end))
        + section("今回の指摘"; $f | map("- " + tag + " " + .title + (if .line == null then "（下に書いています）" else "（インラインに書いています）" end)))
        + ($outside_sections | add // [])
        + section("インラインにしなかった点 / 範囲外"; (if .scope_note then ["- " + .scope_note] else [] end))
      end) as $body
    | {
        commit_id: $head,
        body: ($body | join("\n")),
        closings: {
          ready: ((if $round == 1 then "[must] / [should] の指摘は無く、CI も通っています。" else "[must] / [should] の指摘は残っておらず、CI も通っています。" end) + $nit),
          ci_failed: "[must] / [should] の指摘は無いですが、CI が通っていません。",
          comment: ($blocking + " が直れば approve します。")
        },
        marker: ("<!-- codex-review:v1 round=" + ($round | tostring) + " head=" + $head + " open=" + $saved + " -->"),
        ready,
        comments: [$f[] | select(.line != null) | {
          path: .file, line, side: "RIGHT",
          body: (tag + " " + .title + "\n\n" + detail + "\n\n" + $footer)
        }],
        replies: [.previous[] | select(.status == "resolved" or .status == "explained") | {
          severity, title, path: .file,
          body: ((if .status == "resolved" then "確認しました。" + (.note | stop) + "。ありがとうございます！"
                  else "回答ありがとうございます。" + (.note | stop) + "。" end) + "\n\n" + $footer)
        }]
      }' "$run/findings.json" >"$run/review.json"
}

# Post a built review. kind is the closing line added to the body: ready,
# ci_failed or comment. (組み立てたレビューを投稿する。kind は本文の最後に付ける
#  締めの種類で、ready / ci_failed / comment。)
post_review() {
  local file="$1" event="$2" kind="$3"
  jq --arg event "$event" --arg kind "$kind" --arg footer "$FOOTER" '
    {commit_id, event: $event, comments,
     body: (.body + ((.closings // {})[$kind] // "" | if . == "" then "" else "\n\n" + . end) + "\n\n" + $footer + "\n\n" + .marker)}' "$file" |
    gh api -X POST "repos/$repo/pulls/$number/reviews" --input - --jq .html_url ||
    die "could not post the review; it is kept at $file"
  post_replies "$file"
}

# Reply on the inline comment this script left for each settled finding. A
# finding that was only in the review body has no thread, and a failed reply
# does not undo the review. (解消した指摘ごとに、このスクリプトが付けたインラインの
#  コメントに返信する。本文にだけ書いた指摘にはスレッドがない。返信に失敗しても、
#  投稿したレビューはそのまま。)
post_replies() {
  local file="$1" threads reply id
  [ "$(jq '.replies // [] | length' "$file")" -gt 0 ] || return 0
  threads=$(gh api --paginate --slurp "repos/$repo/pulls/$number/comments" | jq -c --arg me "$me" '
    add // [] | map(select(.user.login == $me and .in_reply_to_id == null))') || return 0
  jq -c '.replies[]' "$file" | while read -r reply; do
    id=$(jq -r --argjson reply "$reply" '
      map(select(.path == $reply.path and (.body | startswith("[" + $reply.severity + "] " + $reply.title + "\n"))))
      | sort_by(.created_at) | last | .id // empty' <<<"$threads")
    [ -n "$id" ] || continue
    jq -n --argjson reply "$reply" '{body: $reply.body}' |
      gh api -X POST "repos/$repo/pulls/$number/comments/$id/replies" --input - >/dev/null ||
      printf '%s#%s: could not reply on comment %s\n' "$repo" "$number" "$id" >&2
  done
}

# 残りのないレビューは CI を待つ。通れば投稿して 6 で終わり、approve は自分でする。
# 落ちれば投稿し、まだなら保留のまま残す。
finish_when_ci_done() {
  local file="$1"
  case "$(ci_state)" in
    pass) post_review "$file" COMMENT ready; rm -f "$pending"; exit 6 ;;
    fail) post_review "$file" COMMENT ci_failed; rm -f "$pending" ;;
    *) printf '%s#%s: waiting for CI\n' "$repo" "$number" ;;
  esac
}

show() {
  jq -r '.body' "$run/review.json"
  if [ "$(jq -r .ready "$run/review.json")" = true ]; then
    printf '\n(CI: %s。pass なら締めは次の1行)\n' "$(ci_state)"
    jq -r '.closings.ready' "$run/review.json"
  else
    jq -r '"\n" + .closings.comment' "$run/review.json"
  fi
  jq -r '.comments[] | "\n--- \(.path):\(.line)\n\(.body)"' "$run/review.json"
  jq -r '.replies[] | "\n--- 返信 \(.path) [\(.severity)] \(.title)\n\(.body)"' "$run/review.json"
  jq -r '.dropped[]? | "\n(落とした指摘) \(.id): \(.reason)"' "$run/findings.json"
  printf '\n(not posted; run again with --post. Saved in %s)\n' "$run"
}

publish() {
  if [ "$(jq -r .ready "$run/review.json")" = true ]; then
    mkdir -p "$(dirname "$pending")"
    jq --arg head "$head" '. + {head: $head}' "$run/review.json" >"$pending"
    finish_when_ci_done "$pending"
  else
    rm -f "$pending"
    post_review "$run/review.json" COMMENT comment
  fi
}

main() {
  parse_args "$@"
  require_environment
  load_pull_request
  load_last_review

  # この head のレビューがもうできていれば、CI を待っているだけ。
  if [ "$post" = true ] && [ -f "$pending" ]; then
    if [ "$(jq -r .head "$pending")" = "$head" ]; then
      finish_when_ci_done "$pending"
      exit 3
    fi
    rm -f "$pending"
  fi

  if [ "$last_head" = "$head" ] && ! author_replied; then
    printf '%s#%s: nothing new since the last review\n' "$repo" "$number"
    exit 3
  fi

  round=$((last_round + 1))
  if [ "$round" -gt "$MAX_ROUNDS" ]; then
    printf '%s#%s: %s rounds done; leaving it to you\n' "$repo" "$number" "$MAX_ROUNDS"
    exit 4
  fi

  checkout
  write_input
  update_graph
  review
  place_findings
  settle_findings
  build_review
  if [ "$post" = true ]; then publish; else show; fi
}

main "$@"
