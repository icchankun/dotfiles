#!/usr/bin/env ruby
# frozen_string_literal: true

# =============================================================================
# rename-cc-session
# Generates a title for a Claude Code session and appends it to the transcript.
# (Claude Code セッションのタイトルを AI で自動生成し、トランスクリプトに追記する。)
#
# Dependencies / 依存:
#   - claude CLI  https://github.com/anthropics/claude-code
#   - activesupport (gem)
#
# Setup / セットアップ:
#   1. Install the claude CLI
#      npm install -g @anthropic-ai/claude-code
#
#   2. Install the required gem
#      gem install activesupport
#
#   3. Register as a Claude Code hook (Stop) in ~/.claude/settings.json
#      "hooks": { "Stop": [{ "command": "rename-cc-session" }] }
#
# Usage / 使い方:
#   Intended to run automatically as a Stop hook.
#   (Stop のフックとして自動実行される想定。Stop は応答のたびに走るので、一定時間
#    あいたときだけタイトルを作り直す。)
#   SessionEnd では走らせない。セッションの終了時には ~/.claude/sessions/<pid>.json
#   がもう消えていて、セッションの素性を調べる術がなくなるため。
#   Reads JSON from stdin with session_id, transcript_path, cwd, etc.
#   (stdin から JSON を受け取り、会話内容を元にタイトルを生成してセッションに保存する。)
# =============================================================================

require 'fileutils'
require 'json'
require 'shellwords'
require 'active_support/core_ext/object/blank'
require 'active_support/core_ext/string/inflections'

class CcSessionRenamer
  def self.call(cc_session_id:, transcript_path:, cwd:, throttle: false)
    new(cc_session_id:, transcript_path:, cwd:, throttle:).call
  end

  def initialize(cc_session_id:, transcript_path:, cwd:, throttle: false)
    @cc_session_id = cc_session_id
    @transcript_path = transcript_path
    @cwd = cwd
    @throttle = throttle
  end

  def call
    return if throttled?

    record_attempt
    title = generate_title
    return unless valid_title?(title)

    rename_cc_session(title)
    rename_herdr_pane(title)
  end

  private

  attr_reader :cc_session_id, :transcript_path, :cwd, :throttle

  # Stop フックは応答のたびに走るので、毎回生成すると Haiku の呼び出しが積み上がる。
  # 会話の主題はそこまで速く動かないため、前回から一定時間あいたときだけ作り直す。
  # 生成に失敗したときも間隔を空けたいので、成否ではなく試行した時刻を記録する。
  REGENERATE_INTERVAL = 10 * 60
  STATE_DIR = File.expand_path('~/.cache/rename-cc-session')

  def throttled?
    return false unless throttle
    return false unless File.exist?(state_path)

    Time.now - File.mtime(state_path) < REGENERATE_INTERVAL
  end

  def record_attempt
    FileUtils.mkdir_p(STATE_DIR)
    FileUtils.touch(state_path)
  end

  def state_path
    File.join(STATE_DIR, cc_session_id.to_s)
  end

  def generate_title
    return if conversation.blank?

    prompt = <<~TEXT
      以下の会話について、次の形式で1行だけ出力してください。
      形式: タイトル#{current_branch} #キーワード1 #キーワード2 #キーワード3
      - タイトルは日本語かつ30文字以内 (できるだけ詳しく)
      - キーワードは固有名詞(英語)または日本語で、3つまで
      - マークダウン記法やプレフィックスは不要
      - 会話への返答や相槌ではなく、タイトルだけを出力する

      出力例: フックのデバッグ#{current_branch} #hook #stdin #ruby

      <conversation>
      #{conversation}
      </conversation>
    TEXT

    `echo #{Shellwords.escape(prompt)} | claude -p --model claude-haiku-4-5-20251001 --setting-sources '' --no-session-persistence 2>/dev/null`.lines.first&.strip
  end

  # タイトルではなく会話の続きや断り文、CLI のエラーが返ることがあるので弾く。
  # 書式どおりなら必ずキーワードの # が付くため、それを主な手掛かりにする。
  MAX_TITLE_LENGTH = 120
  INVALID_TITLE_PATTERNS = [/\A申し訳/, /\ANot logged in/, /[。！？]\z/].freeze
  def valid_title?(title)
    return false if title.blank?
    return false if title.length > MAX_TITLE_LENGTH
    return false if INVALID_TITLE_PATTERNS.any? { |pattern| title.match?(pattern) }

    title.include?('#')
  end

  # 長すぎる会話はタイトル生成の精度が落ちるうえ、コマンドライン長の上限にも触れる。
  MAX_CONVERSATION_LENGTH = 12_000
  def conversation
    @conversation ||= begin
      text = build_messages.join("\n")
      if text.length > MAX_CONVERSATION_LENGTH
        half = MAX_CONVERSATION_LENGTH / 2
        text = "#{text[0, half]}\n…(中略)…\n#{text[-half..]}"
      end
      text
    end
  end

  def build_messages
    File.foreach(transcript_path).each_with_object([]) do |line, messages|
      message = build_message(line)
      messages << message if message
    end
  end

  TARGET_MESSAGE_TYPES = %w[user assistant].freeze
  def build_message(line)
    line_hash = JSON.parse(line) rescue return
    message_type = line_hash['type']
    return unless TARGET_MESSAGE_TYPES.include?(message_type)

    content = extract_message_content(line_hash)
    return if content.blank?

    "#{message_type.titleize}: #{content}"
  end

  TARGET_MESSAGE_CONTENT_TYPE = 'text'
  def extract_message_content(obj)
    content = obj.dig('message', 'content')

    case content
    when Array
      content.select { |c| c.is_a?(Hash) && c['type'] == TARGET_MESSAGE_CONTENT_TYPE }
             .map { |c| c['text'].to_s }
             .join(' ')
    when String then content
    else ''
    end
  end

  def current_branch
    branch = `git -C #{Shellwords.escape(cwd)} rev-parse --abbrev-ref HEAD 2>/dev/null`.strip
    branch.present? ? " [#{branch}]" : ''
  end

  # ここで書くのはセッションのタイトルで、Herdr の agent 名や
  # ~/.claude/sessions/<pid>.json の name とは別物。SendMessage の宛先も statusline も
  # 後者を読んでいるので、生成タイトルを入れても宛先は見失われない。
  def rename_cc_session(title)
    entry = JSON.generate({ type: 'custom-title', customTitle: title, sessionId: cc_session_id })
    File.open(transcript_path, 'a') { |f| f.puts(entry) }
  end

  # Herdr のペインボーダーは 手動ペイン名 > agent ラベル > ターミナルタイトル の順に
  # 表示を選ぶ。手動ペイン名に生成タイトルを入れておくと、ボーダーがそのペインの
  # 作業内容を語る。agent 名は Herdr 側にも残るので、宛先は agent ラベルで引ける。
  def rename_herdr_pane(title)
    return unless ENV['HERDR_ENV'] == '1'
    return if ENV['HERDR_PANE_ID'].blank?

    system('herdr', 'pane', 'rename', ENV['HERDR_PANE_ID'], title, out: File::NULL, err: File::NULL)
  end
end

# $stdin で以下のような json が渡ってくる
# {
#   "session_id":"91d590b5-...",
#   "transcript_path":"~/.claude/projects/hoge.jsonl"
#   "cwd":"~/workspace/hoge",
#   "hook_event_name":"SessionEnd",
#   "reason":"prompt_input_exit"
# }
input = JSON.parse($stdin.read)
CcSessionRenamer.call(
  cc_session_id: input['session_id'],
  transcript_path: input['transcript_path'],
  cwd: input['cwd'],
  throttle: input['hook_event_name'] == 'Stop'
)
