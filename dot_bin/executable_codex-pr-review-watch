#!/usr/bin/env bash

# Run codex-pr-review on the pull requests I am asked to review.
# (レビューを頼まれた PR に codex-pr-review を流す。)
#
# Dependencies / 依存:
#   - gh, codex-pr-review, codex-dep-review, osascript (macOS notifications / macOS の通知)
#   - the repositories to review, in DEV_FLOW_REPOS (space separated) or
#     ~/.config/dev-flow/repos (one per line). Both the pull request reviews and
#     the dependency update checks run only there. Kept out of dotfiles, which
#     are public. (レビューするリポジトリ。DEV_FLOW_REPOS（空白区切り）か
#      ~/.config/dev-flow/repos（1行に1つ）。PR のレビューも依存更新の確認も、
#      ここに書いたリポジトリだけで動く。dotfiles は公開しているので、そこには
#      入れない。)
#
# What a run does / 1回の実行ですること:
#   - Only on weekdays from 9:00 to 20:00. (平日 9:00〜20:00 だけ動く。)
#   - Does nothing on a machine without Codex, without a notification.
#     (Codex が入っていない端末では、知らせずに何もしない。)
#   - Picks up open, non-draft pull requests in those repositories that request
#     my review in person (user-review-requested:@me) and keeps following them
#     until they close:
#     GitHub drops the request once a review is posted, but later rounds still
#     need this script. (自分個人にレビュー依頼が来た、draft でない open の PR を
#     拾い、閉じるまで追い続ける。レビューを投稿すると GitHub は依頼を消すが、その
#     あとのラウンドも見る必要があるため。)
#   - Leaves out release pull requests: they bundle changes already reviewed in
#     their own pull requests, so reviewing them again only spends Codex's
#     usage allowance. The base branch does not decide it, since some
#     repositories send every pull request to main.
#     (リリースの PR は外す。それぞれの PR でレビュー済みの変更をまとめたもの
#      なので、もう一度レビューしても Codex の利用枠を使うだけなので。ベースの
#      ブランチでは決めない（すべての PR を main に出すリポジトリもある）。)
#   - Uses Codex on at most MAX_PRS pull requests, so a pile of requests does not
#     drain the usage allowance in one go; the rest wait for the next run.
#     (Codex を使うのは MAX_PRS 件まで。依頼がまとめて来ても、一度に利用枠を使い
#      切らないため。残りは次の回に回す。)
#   - When Codex hits its usage limit, pauses until the reset time Codex gives,
#     and resumes with the pull requests left. (Codex の利用枠が切れたら、Codex が
#     示す時刻まで止め、残りの PR から再開する。)
#   - Checks the open dependency updates from Renovate and Dependabot in those
#     repositories with codex-dep-review, at most MAX_DEP_PRS a run. Approving
#     and merging are left to a person. (それらのリポジトリの Renovate と Dependabot の
#     依存更新を codex-dep-review で確かめる。1回に MAX_DEP_PRS 件まで。approve と
#     merge は人がする。)
#   - Once a week, runs codex-dep-report to compare those verdicts with what I
#     did, and notifies the summary. (週に1回、codex-dep-report でその判定と自分の
#     判断を比べ、要約を知らせる。)
#   - Notifies only what needs me: a pull request ready for my approval, one
#     handed over after too many rounds, a dependency update to approve or to
#     check myself, a failure, and a pause. Each is notified once, a failure once a day.
#     (知らせるのは自分が要るものだけ。approve を待つ PR、ラウンドが多すぎて任された
#      PR、approve するか自分で見る依存更新、失敗、一時停止。同じものは1回だけ知らせる。失敗は1日1回。)

set -euo pipefail

readonly MAX_PRS=3
readonly MAX_DEP_PRS=5
readonly RELEASE_JQ='
  (.title | test("リリース|\\brelease\\b"; "i"))
  or (.headRefName | test("^release[/-]"; "i"))
  or any(.labels[]?; .name | test("^(release|リリース)$"; "i"))'
readonly REPOS_FILE="$HOME/.config/dev-flow/repos"
readonly STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/codex-pr-review"
readonly TRACKED="$STATE_DIR/tracked"
readonly PAUSED="$STATE_DIR/paused-until"
readonly NOTIFIED="$STATE_DIR/notified"
readonly LOCK="$STATE_DIR/watch.lock"
# A lock older than this is removed even if its pid is alive. (これより古いロックは、
# pid が生きていても消す。)
readonly LOCK_STALE_MINUTES=180

log() { printf '%s %s\n' "$(date '+%F %T')" "$*"; }

# Notify once per key; the keys already sent are in NOTIFIED.
# (同じ key では1回だけ知らせる。知らせた key は NOTIFIED に記録する。)
notify() {
  local key="$1" message="$2"
  grep -qxF "$key" "$NOTIFIED" && return 0
  printf '%s\n' "$key" >>"$NOTIFIED"
  log "notify: $message"
  osascript -e "display notification \"${message//\"/}\" with title \"codex-pr-review\"" >/dev/null 2>&1 || true
}

in_working_hours() {
  local dow hour
  dow=$(date +%u) hour=$((10#$(date +%H)))
  [ "$dow" -le 5 ] && [ "$hour" -ge 9 ] && [ "$hour" -lt 20 ]
}

# The epoch Codex says its allowance comes back, read from its error
# ("Try again at 3:45 PM." or "... at Nov 2nd, 2026 3:45 PM."). 30 minutes from
# now when the time cannot be read.
# (Codex のエラーから、利用枠が戻る時刻を epoch で読む。読めなければ30分後にする。)
reset_epoch() {
  local at
  at=$(printf '%s' "$1" | grep -io 'try again at [^.]*' | tail -n 1 | sed -E 's/^[Tt]ry again at //; s/([0-9]+)(st|nd|rd|th),/\1,/') || true
  if [[ "$at" =~ ^[0-9]{1,2}:[0-9]{2}\ [AP]M$ ]]; then
    at="$(date +%F) $at"
    date -j -f '%Y-%m-%d %I:%M %p' "$at" +%s 2>/dev/null || date -d "$at" +%s 2>/dev/null && return
  elif [ -n "$at" ]; then
    date -j -f '%b %d, %Y %I:%M %p' "$at" +%s 2>/dev/null || date -d "$at" +%s 2>/dev/null && return
  fi
  echo $(($(date +%s) + 1800))
}

# Add the pull requests that request my review to the tracked list, keeping
# only those in the repositories to review. Pull requests from a repository
# taken off the list are dropped from it too.
# (自分にレビュー依頼が来た PR を、追いかける一覧に足す。残すのはレビューする
#  リポジトリのものだけ。リストから外したリポジトリの PR は、一覧からも外す。)
discover() {
  local found repos
  repos=$(review_repos)
  if [ -z "$repos" ]; then
    log "no repositories to review; set DEV_FLOW_REPOS or $REPOS_FILE"
    : >"$TRACKED"
    return 0
  fi
  found=$(gh search prs "user-review-requested:@me" --state open --draft=false --limit 100 \
    --json repository,number --jq '.[] | "\(.repository.nameWithOwner)#\(.number)"') ||
    { log "could not search pull requests"; return 0; }
  { cat "$TRACKED"; [ -z "$found" ] || printf '%s\n' "$found"; } | sort -u |
    awk -F'#' 'NR == FNR { keep[tolower($0)] = 1; next } tolower($1) in keep' <(printf '%s\n' "$repos") - >"$TRACKED.new" || true
  mv "$TRACKED.new" "$TRACKED"
}

# The repositories to review: pull requests and dependency updates.
# (レビューするリポジトリ。PR も依存更新も。)
review_repos() {
  if [ -n "${DEV_FLOW_REPOS:-}" ]; then
    printf '%s\n' $DEV_FLOW_REPOS
  elif [ -f "$REPOS_FILE" ]; then
    grep -vE '^[[:space:]]*(#|$)' "$REPOS_FILE"
  fi
}

# Open, non-draft dependency updates in those repositories.
# (それらのリポジトリの、draft でない open の依存更新。)
dep_pull_requests() {
  local repo bot
  review_repos | while read -r repo; do
    for bot in app/renovate app/dependabot; do
      gh pr list -R "$repo" --author "$bot" --state open --json number,isDraft \
        --jq ".[] | select(.isDraft | not) | \"$repo#\(.number)\"" 2>/dev/null || log "$repo: could not list $bot"
    done
  done
}

# Pause until Codex's allowance comes back, and say so once.
# (Codex の利用枠が戻るまで止め、1回だけ知らせる。)
pause_for_limit() {
  local until
  until=$(reset_epoch "$1")
  printf '%s\n' "$until" >"$PAUSED"
  notify "pause:$until" "Codex の利用枠が切れました。$(date -r "$until" +%H:%M 2>/dev/null || date -d "@$until" +%H:%M) から再開します"
}

# Check the dependency updates. Returns 1 when Codex hit its usage limit.
# (依存更新を確かめる。Codex の利用枠が切れたら 1 を返す。)
check_dependency_updates() {
  local used=0 pr out status head
  # The list is read from fd 3, so the commands in the loop cannot read the rest
  # of it from stdin. (一覧は fd 3 から読む。ループの中のコマンドが、標準入力から
  # 残りを読んでしまわないように。)
  while read -r pr <&3; do
    [ -n "$pr" ] || continue
    [ "$used" -lt "$MAX_DEP_PRS" ] || { log "checked $MAX_DEP_PRS dependency updates; the rest wait"; break; }

    if out=$(codex-dep-review --post "$pr" 2>&1); then status=0; else status=$?; fi
    [ -z "$out" ] || printf '%s\n' "$out" | sed "s|^|$(date '+%F %T') $pr: |"
    head=$(printf '%s\n' "$out" | sed -n 's/^result: [a-z_]* //p' | tail -n 1)

    case "$status" in
      0) used=$((used + 1)) ;;
      3) ;;
      5) used=$((used + 1)); notify "$pr:deps:$head" "$pr の依存更新は、自分で見てください" ;;
      6) used=$((used + 1)); notify "$pr:deps-ok:$head" "$pr の依存更新は ok でした。approve するか見てください" ;;
      75) pause_for_limit "$out"; return 1 ;;
      *) notify "$pr:deps-error:$(date +%F)" "$pr の依存更新の確認に失敗しました。~/Library/Logs/codex-pr-review.log を見てください" ;;
    esac
  done 3< <(dep_pull_requests)
}

# On the first run of each week from Monday, compare the dependency verdicts with
# what I did, and say how they compare. (週の最初の回（月曜から）に、依存更新の
# 判定と自分の判断を比べ、その結果を知らせる。)
weekly_report() {
  local week
  week=$(date +%G-W%V)
  [ "$(cat "$STATE_DIR/report-week" 2>/dev/null)" != "$week" ] || return 0
  [ -s "$STATE_DIR/deps-shadow.tsv" ] || return 0
  codex-dep-report --notify || { log "codex-dep-report failed"; return 0; }
  printf '%s\n' "$week" >"$STATE_DIR/report-week"
}

# Take the lock, removing one left by a run whose process is gone or that is
# older than LOCK_STALE_MINUTES. (ロックを取る。プロセスがもういない回か、
# LOCK_STALE_MINUTES より古い回が残したロックは消す。)
take_lock() {
  local pid
  if ! mkdir "$LOCK" 2>/dev/null; then
    pid=$(cat "$LOCK/pid" 2>/dev/null || true)
    # No pid yet means the other run has only just made the lock.
    # (pid がまだないのは、相手がロックを作った直後。)
    if { [ -z "$pid" ] || kill -0 "$pid" 2>/dev/null; } &&
      [ -z "$(find "$LOCK" -maxdepth 0 -mmin +"$LOCK_STALE_MINUTES")" ]; then
      return 1
    fi
    log "removing a stale lock${pid:+ (pid $pid)}"
    rm -rf "$LOCK"
    mkdir "$LOCK" 2>/dev/null || return 1
  fi
  printf '%s\n' "$$" >"$LOCK/pid"
}

untrack() {
  grep -vxF "$1" "$TRACKED" >"$TRACKED.new" || true
  mv "$TRACKED.new" "$TRACKED"
}

main() {
  mkdir -p "$STATE_DIR"
  touch "$TRACKED" "$NOTIFIED"

  in_working_hours || exit 0
  command -v codex >/dev/null || exit 0
  take_lock || { log "the previous run is still going"; exit 0; }
  trap 'rm -rf "$LOCK"' EXIT

  if [ -f "$PAUSED" ]; then
    if [ "$(date +%s)" -lt "$(cat "$PAUSED")" ]; then
      exit 0
    fi
    rm -f "$PAUSED"
    log "resumed after the usage limit"
  fi

  discover

  local used=0 pr repo number state out status
  while read -r pr <&3; do
    [ -n "$pr" ] || continue
    [ "$used" -lt "$MAX_PRS" ] || { log "used Codex on $MAX_PRS pull requests; the rest wait"; break; }

    repo="${pr%%#*}" number="${pr##*#}"
    state=$(gh pr view "$number" -R "$repo" --json state,isDraft,title,headRefName,labels |
      jq -r "def release: $RELEASE_JQ;"' if .state != "OPEN" then "closed" elif release then "release" elif .isDraft then "draft" else "open" end') ||
      { log "$pr: could not read"; continue; }
    case "$state" in
      closed) untrack "$pr"; log "$pr: closed; no longer followed"; continue ;;
      release) untrack "$pr"; log "$pr: a release pull request; not reviewed"; continue ;;
      draft) continue ;;
    esac

    if out=$(codex-pr-review --post "$pr" 2>&1); then status=0; else status=$?; fi
    [ -z "$out" ] || printf '%s\n' "$out" | sed "s|^|$(date '+%F %T') $pr: |"

    case "$status" in
      0) used=$((used + 1)) ;;
      3) ;;
      4) notify "$pr:handover" "$pr はラウンドが多すぎるので、自分で見てください" ;;
      # 6 is counted as a Codex run even when only CI was checked, so a run may stop short of MAX_PRS
      6) used=$((used + 1)); notify "$pr:ready:$(grep -o 'pullrequestreview-[0-9]*' <<<"$out" | tail -n 1)" "$pr は指摘が残っておらず CI も通りました。approve するか見てください" ;;
      75) pause_for_limit "$out"; return 0 ;;
      *) notify "$pr:error:$(date +%F)" "$pr のレビューに失敗しました。~/Library/Logs/codex-pr-review.log を見てください" ;;
    esac
  done 3< <(cat "$TRACKED")

  check_dependency_updates || true
  weekly_report
}

main "$@"
