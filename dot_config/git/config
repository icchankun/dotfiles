[init]
	defaultBranch = main
[core]
	commentChar = ^
	editor = code --wait
[pull]
	rebase = true
[wt]
	# ~/.graphify/projects に貯めた graphify のグラフをコピーする。Herdr で開く前に置き、最初のターンから使えるようにする
	hook = ~/.bin/graphify-store seed
	# worktree を作ったら Herdr のタブに自動で開く
	hook = ~/.bin/herdr-worktree-open
[hook "betterleaks"]
	# 全リポジトリでコミット前にシークレットを検出する
	command = mise exec -- betterleaks git --pre-commit --redact --staged --verbose
	event = pre-commit
