[init]
	defaultBranch = main
[core]
	commentChar = ^
	editor = code --wait
[wt]
	# worktree を作ったら Herdr のタブに自動で開く
	hook = ~/.bin/herdr-worktree-open
	# graphify のグラフ（gitignore 済み）を新しい worktree にも持ち込む。続きから更新できる
	copy = graphify-out/
[hook "betterleaks"]
	# 全リポジトリでコミット前にシークレットを検出する
	command = mise exec -- betterleaks git --pre-commit --redact --staged --verbose
	event = pre-commit
